import { createElement, Fragment, mount, hydrate, html, flush, stringHost, useState,
    Boundary } from "../lath.slx"
import { domHost } from "../dom.slx"
import { attribute, byId } from slate:dom
import { at, click, says, shown, mutations } from "./probe.slx"

// Hydration against a real document, measured by a `MutationObserver`.
//
// **The observer is the whole point and nothing else would do.** Counting what lath asked the host to
// do would only say that lath believes it touched nothing; an observer is the browser's own answer,
// and it sees a write the framework did not know it was making -- an attribute set to the value it
// already held, a child list replaced with the same children, a text node rewritten with the same
// text. `tests/hydrate.slx` counts what the host was asked for, which is the other half; this counts
// what the page recorded.
//
// **The markup comes from lath's own string host**, which is what makes the whitespace question
// answer itself: a tree hydrating against its own output is exact, and a page pretty-printed by
// anything else is a mismatch and ought to be.

Row(props: object) = <li class="row" data-id={props.id}>{props.name}</li>

Counter(props: object) =
    val [n, setN] = useState(0)

    <button id="tick" type="button" onClick={() -> setN(n + 1)}>{string(n)}</button>

// **A tree with every shape hydration has to walk**: an element with attributes, text, a nested
// element, a list built from data, a component with state, and a fragment -- which has no node of
// its own and whose children stand among its parent's.
App(props: object) =
    <div class="app">
        <h1>Hydrated</h1>
        <ul>
            <Row id="1" name="one"/>
            <Row id="2" name="two"/>
        </ul>
        <><span>a</span><span>b</span></>
        <Counter/>
    </div>

// What a server would have sent.
sent() -> string = html(mount(<App/>, stringHost()))

fell(f) -> string =
    var said = ""

    try
        f()
    catch e
        said = e.message

    said

@test
async A_HYDRATED_PAGE_MAKES_NO_MUTATIONS_AT_ALL()
    val markup = sent()

    at(markup)

    // The records for planting the markup are the harness's own; the measurement starts after them.
    await sleep(1)

    val before = mutations()

    hydrate(<App/>, domHost("#page"))

    await sleep(1)

    assertEq(mutations() - before, 0)

    // And what is on the page is still exactly what was sent, character for character.
    assertEq(shown(), "<div id=\"page\">" + markup + "</div>")

@test
async A_MOUNTED_RENDER_INTO_THE_SAME_MARKUP_RECORDS_PLENTY()
    // **The control**, and it is the way a measurement of "nothing happened" fails: without it the
    // zero above could be zero because the observer was watching the wrong thing.
    at(sent())

    await sleep(1)

    val before = mutations()

    mount(<App/>, domHost("#page"))

    await sleep(1)

    assert(mutations() - before > 0)

@test
async THE_HANDLERS_IT_ATTACHED_ACTUALLY_WORK()
    // **This is what hydration is FOR.** The markup a server sent is already the page; what it does
    // not have is a single event listener, and the tree that was walked is what installs them.
    at(sent())

    hydrate(<App/>, domHost("#page"))

    assertEq(says("tick"), "0")

    click("#tick")

    await sleep(1)

    assertEq(says("tick"), "1")

@test
MARKUP_THAT_DOES_NOT_MATCH_IS_A_FAULT_NAMING_THE_PATH_AND_BOTH_SIDES()
    // **There is no falling back to a client render**, which is the user-facing decision: a page that
    // quietly rebuilt what it could not adopt would hide a server and a client that disagree -- the
    // one defect hydration exists to expose -- behind a page that looks right.
    val bent = sent().replace("<h1>Hydrated</h1>", "<h2>Hydrated</h2>")

    at(bent)

    val said = fell(() -> hydrate(<App/>, domHost("#page")))

    assert(contains(said, "the page does not match what was rendered"))
    assert(contains(said, "#page > 0 > 0"))
    assert(contains(said, "wants <h1>"))
    assert(contains(said, "has <h2>"))

@test
A_STRING_HOST_STILL_REFUSES_TO_HYDRATE_EVEN_WHERE_THERE_IS_A_DOCUMENT()
    // A server is what renders the markup a page adopts and never adopts anything itself, and being
    // run in a page does not change that.
    assert(contains(fell(() -> hydrate(<App/>, stringHost())),
        "a string host has nothing to hydrate"))

// -- what the markup cannot say, and what must not be written again -------------------------------

// **These four were found by a real application and reduced to the smallest program each one is.**
// All four are one thing said four ways: the markup a server writes has to be walkable back into the
// tree that wrote it. Two of them were not -- a seam between two text children and an empty text
// child both disappear into the markup -- and two were written again on the way in for nothing.
//
// **The measurement is the observer and not a count of what lath asked for**, which is what makes
// the last two answerable at all: setting a property is not a call the framework could have counted
// as a mutation, and on a field whose value reflects to its content attribute the browser records
// one.

// How many mutation records the browser made while a component hydrated against its own markup.
async records(P) -> integer
    at(html(mount(P({}), stringHost())))

    await sleep(1)

    val before = mutations()

    hydrate(<P/>, domHost("#page"))

    await sleep(1)

    mutations() - before

Adjacent(props: object) = <h2>{2} replies</h2>

Blank(props: object) = <p>{""}</p>

Valued(props: object) = <input type="hidden" name="token" value="a-token"/>

Rowed(props: object) = <textarea id="notes" rows={5}></textarea>

Plain(props: object) = <p class="said">nothing to do here</p>

@test
async TWO_TEXT_CHILDREN_IN_A_ROW_HYDRATE_AGAINST_THE_ONE_NODE_A_PARSER_MADE()
    // `<h2>{2} replies</h2>` is `<h2>2 replies</h2>` in the markup and ONE text node in the page,
    // whatever the tree that wrote it was made of. lath joins the run before it makes an instance,
    // so the two sides count the same children -- and the page is not touched.
    assertEq(await records(Adjacent), 0)

    assertEq(shown(), "<div id=\"page\"><h2>2 replies</h2></div>")

@test
async AN_EMPTY_TEXT_CHILD_HYDRATES_AGAINST_MARKUP_WITH_NOTHING_IN_IT()
    // `<p>{""}</p>` writes `<p></p>` -- there is nothing for an empty string to write -- so the tree
    // holds no node for it either.
    assertEq(await records(Blank), 0)

@test
async A_VALUE_ALREADY_ON_THE_PAGE_IS_NOT_WRITTEN_AGAIN()
    // **`value` is a PROPERTY and not an attribute**, which is what keeps a re-render from freezing a
    // field somebody is typing in -- and the property write used to happen with no comparison at all.
    // On a `hidden` input the property reflects to the content attribute, so the page recorded a
    // change to the value it already held; on a field being typed in, hydration would have taken what
    // was typed.
    assertEq(await records(Valued), 0)

@test
async A_NUMERIC_ATTRIBUTE_IS_COMPARED_AS_THE_TEXT_IT_IS_ON_THE_PAGE()
    // An attribute is text, always. `rows={5}` is the ordinary way to write one and the page answers
    // `"5"`, so a comparison that asked whether the number 5 was the string "5" rewrote an attribute
    // that was already right.
    assertEq(await records(Rowed), 0)

@test
async A_PAGE_WITH_NONE_OF_THEM_ON_IT_RECORDS_NOTHING_EITHER()
    // **The control for all four**, and it is what says the measurement is of these and not of
    // hydration in general.
    assertEq(await records(Plain), 0)

@test
async A_MOUNT_OF_THE_SAME_FOUR_RECORDS_PLENTY()
    // **The other control**, and it is the way a measurement of "nothing happened" fails: without it
    // every zero above could be a zero because nothing ran.
    at(html(mount(<Valued/>, stringHost())))

    await sleep(1)

    val before = mutations()

    mount(<Valued/>, domHost("#page"))

    await sleep(1)

    assert(mutations() - before > 0)

@test
async AN_ATTRIBUTE_THE_SERVER_GOT_WRONG_IS_STILL_THE_ONE_THING_A_HYDRATION_WRITES()
    // **A stale value is not a mismatched TREE**: the shape is right and one value is out of date, so
    // the render corrects it rather than refusing -- which is the line between the two, and is what
    // says the comparison above is a comparison and not a decision to leave attributes alone.
    at("<textarea id=\"notes\" rows=\"4\"></textarea>")

    await sleep(1)

    val before = mutations()

    hydrate(<Rowed/>, domHost("#page"))

    await sleep(1)

    assertEq(mutations() - before, 1)
    assertEq(attribute(byId("notes"), "rows"), "5")

@test
async A_FIELD_IS_STILL_WRITTEN_ON_EVERY_RENDER_AFTER_THE_FIRST()
    // **The comparison is the FIRST write to a node and no other**, which is the whole of why this
    // test is here. A page parsed from markup has the property its attribute gave it and nobody has
    // typed yet; afterwards the attribute no longer says what the field holds, so a render that
    // skipped would leave a controlled input showing something the tree does not.
    var setter = null

    Field(props: object) =
        val [token, setToken] = useState("a-token")

        setter = setToken

        <input id="token" type="hidden" name="token" value={token}/>

    at(html(mount(<Field/>, stringHost())))

    await sleep(1)

    val root = hydrate(<Field/>, domHost("#page"))

    setter("b-token")
    flush(root)

    await sleep(1)

    assertEq(attribute(byId("token"), "value"), "b-token")

@test
async TEXT_THAT_STOPS_BEING_EMPTY_ARRIVES_AS_A_NODE_ON_THE_PAGE()
    // The other half of the empty text child: it holds no node while it is empty and takes one the
    // moment it is not, put where it goes by the ordinary child diff.
    var setter = null

    Note(props: object) =
        val [said, setSaid] = useState("")

        setter = setSaid

        <p>{said}</p>

    at(html(mount(<Note/>, stringHost())))

    val root = hydrate(<Note/>, domHost("#page"))

    assertEq(shown(), "<div id=\"page\"><p></p></div>")

    setter("hi")
    flush(root)

    assertEq(shown(), "<div id=\"page\"><p>hi</p></div>")

    setter("")
    flush(root)

    assertEq(shown(), "<div id=\"page\"><p></p></div>")

@test
A_BOUNDARY_DOES_NOT_CATCH_A_HYDRATION_MISMATCH()
    // **A mismatch is a fault in the contract with the server and not in a component**, so it goes
    // past every boundary above it. A boundary that caught one would render its fallback into markup
    // that is not the fallback's, and the escaping fault would name the FALLBACK's tree -- so the
    // sentence saying which element actually disagreed is gone. That cost an application a day.
    var shownFallback = false

    fallback(e) =
        shownFallback = true

        <em>caught</em>

    Broken(props: object) = <p>x</p>

    Guarded(props: object) =
        <div><Boundary fallback={fallback}><Broken/></Boundary></div>

    at("<div><span>x</span></div>")

    val said = fell(() -> hydrate(<Guarded/>, domHost("#page")))

    assert(contains(said, "#page > 0 > 0"))
    assert(contains(said, "wants <p>"))
    assert(contains(said, "has <span>"))
    assertEq(shownFallback, false)

    // And the page is exactly as it was: nothing was half-rebuilt on the way out.
    assertEq(shown(), "<div id=\"page\"><div><span>x</span></div></div>")

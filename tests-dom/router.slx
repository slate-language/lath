import { createElement, Fragment, mount, useEffect, useState } from "../lath.slx"
import { router, Link, Anything, navigateWith, useSearch, useRoute } from "../router.slx"
import { domHost, usePath } from "../dom.slx"
import { location, pushPath, back, forward, byId, onNavigate } from dom
import { at, click, says, shown, navigations, prevented, mutations, touched, focus,
    active } from "./probe.slx"

// The router against a real document: a link is clicked, the address bar moves, the view changes --
// and the clicks that belong to the browser are left to it.
//
// **This is the half `slate test tests` cannot reach, and for a sharper reason than the host's.**
// Everything else the router decides is checked there by handing it a string; what cannot be checked
// without a document is whether a click belongs to the router or to the browser, because that is
// read off `mods` and `button`, which the browser puts on the event and nothing else can produce.
//
// **A refusal is measured two ways and both are needed.** `prevented()` says the router did not call
// `preventDefault`, which is what leaving a click alone means; `navigations()` says the browser then
// went and tried to follow it, which is what says the anchor was a working anchor and not a broken
// one. A router that swallowed a click would fail the first; a router whose links were dead would
// pass the first and fail the second.

Home(props: object) = <p id="view">home, and <Link to="/notes/7" id="toNote">a note</Link></p>

Note(props: object) = <p id="view">note {props.id}, and <Link to="/" id="toHome">home</Link></p>

Away(props: object) =
    <p id="view">away, and <Link to="https://example.com/x" id="toAway">off site</Link></p>

Missing(props: object) = <p id="view">nothing at {props.at}</p>

pageRoutes() =
    [{ path: "/", view: (m) -> <Home/> },
     { path: "/notes/:id", view: (m) -> <Note id={m.params.id}/> },
     { path: "/away", view: (m) -> <Away/> },
     { path: Anything, view: (m) -> <Missing at={m.path}/> }]

// **The whole of what a page writes.** `usePath` holds the address as state and tells every `Link` to
// push rather than follow; the router is a function of that path and knows nothing else.
App(props: object) = router(pageRoutes(), usePath())

// The page emptied and the application mounted, with the address bar put back at the root first --
// so that a test says where it starts rather than inheriting where the last one finished.
fresh(from: string) =
    pushPath(from)
    at("")

    mount(<App/>, domHost("#page"))

@test
A_Link_IS_A_REAL_ANCHOR_CARRYING_AN_href_AND_THE_ROUTERS_MARK()
    // **Which is what makes the page one program.** The markup is the same on a server and in a
    // browser, the link works with no slate on the page at all, and a middle click is a middle click
    // because what was rendered is an ordinary anchor.
    fresh("/")

    assertEq(says("view"), "home, and a note")
    assert(contains(shown(), "<a"))
    assert(contains(shown(), "href=\"/notes/7\""))
    assert(contains(shown(), "data-lath-link"))

@test
async A_PLAIN_CLICK_CHANGES_THE_VIEW_WITHOUT_A_PAGE_LOAD()
    fresh("/")

    val followed = navigations()

    click("#toNote")

    await sleep(1)

    assertEq(says("view"), "note 7, and home")
    assertEq(location().path, "/notes/7")

    // Taken means prevented, and prevented means the browser never went anywhere.
    assert(prevented())
    assertEq(navigations() - followed, 0)

@test
async A_MODIFIED_CLICK_AND_A_MIDDLE_CLICK_ARE_THE_BROWSERS()
    // **The assertion the whole of `mods` and `button` was added to `slate:dom` for.** A router that
    // took these would swallow cmd-click, shift-click and middle-click, which is the most ordinary
    // thing anybody does to a link.
    fresh("/notes/7")

    val followed = navigations()

    for spec in ["click meta", "click ctrl", "click shift", "click alt", "click button=1"]
        click("#toHome", spec)

        await sleep(1)

        assert(!prevented(), spec + " should have been left to the browser")
        assertEq(says("view"), "note 7, and home")
        assertEq(location().path, "/notes/7")

    // **Five clicks the browser was left to follow, and it tried to follow every one.** jsdom cannot
    // navigate, and saying so is exactly the evidence: a router that had wrongly swallowed one would
    // leave four.
    assertEq(navigations() - followed, 5)

@test
async AND_A_PLAIN_CLICK_ON_THE_SAME_LINK_IS_TAKEN()
    // Which is the pair that says the five above were refused for what they were and not because the
    // link was broken.
    fresh("/notes/7")

    val followed = navigations()

    click("#toHome")

    await sleep(1)

    assert(prevented())
    assertEq(says("view"), "home, and a note")
    assertEq(location().path, "/")
    assertEq(navigations() - followed, 0)

@test
async A_LINK_TO_ANOTHER_ORIGIN_IS_THE_BROWSERS()
    fresh("/away")

    val followed = navigations()

    click("#toAway")

    await sleep(1)

    assert(!prevented())
    assertEq(says("view"), "away, and off site")
    assertEq(navigations() - followed, 1)

@test
async THE_BACK_BUTTON_MOVES_THE_VIEW_AND_A_PUSH_DOES_NOT_RAISE_ONE()
    // **`pushPath` does not raise `onNavigate` and a back does**, which is what `usePath` is written
    // around: a push sets the state itself, and the listener is only ever the history buttons.
    fresh("/")

    click("#toNote")

    await sleep(1)

    assertEq(location().path, "/notes/7")

    back()

    await sleep(50)

    assertEq(location().path, "/")
    assertEq(says("view"), "home, and a note")

// -- an application that holds the address itself ---------------------------------------------------

// **A page may mean more by following a link than moving the view**, and the board does: it fetches
// the record the next page renders from, keeps it in state and writes `<html data-theme>` beside it.
// So it says what a link means with `navigateWith` and holds the URL in a `useState` of its own,
// which is the arrangement these two check -- and the one that broke.
//
// **What made it break is that asking for the query INSTALLS a navigator.** `useSearch` reads the
// address bar through `usePath`, so every control that wants a sort or a page number -- three of them
// on the board's front page -- registered `usePath`'s own `go` as a side effect of asking. One slot
// meant the last of them won: a click moved the address bar and re-rendered that one control, the
// application never heard, and the page sat there. In a real browser it looked like state setters had
// stopped working; the address bar moved and nothing else happened at all.

// Where the application's own navigator was asked to go.
var went = []

// And the navigator itself, so that a test can move the page the way the application does -- which is
// not a click on a link and is the case a hook holding its own copy of the path gets wrong.
var goes = null

// A control that wants nothing but the query, which is what every sort control and pager is.
Sorting(props: object) =
    val [q, set] = useSearch()

    <span id="sort">{q.sort ?? "none"}</span>

// The page, holding the address itself the way an application that fetches on navigation must.
Own(props: object) =
    val [here, setHere] = useState("/")

    go(to, opts = null)
        push(went, to)
        pushPath(to)
        setHere(to)

    goes = go

    // **What a page listening for the back button itself looks like**, which is what `client.slx`
    // does: a push does not raise `onNavigate`, so a movement the reader made is the only thing this
    // hears, and it is the page's own state that has to follow it.
    moved(where)
        push(went, where)
        setHere(where)

    wire()
        navigateWith(go)
        onNavigate(moved)

        null

    useEffect(wire, [])

    <p id="view">at {here}, <Link to="/notes/7?sort=newest" id="toNote">a note</Link> <Sorting/></p>

owned() =
    went = []

    pushPath("/")
    at("")

    mount(<Own/>, domHost("#page"))

@test
async A_PAGE_THAT_SAID_WHAT_A_LINK_MEANS_IS_THE_ONE_A_CLICK_REACHES()
    // **The assertion the whole two-slot arrangement exists for.** A control below asked for the
    // query, which installs the built-in navigator; what a `Link` calls is still the one this page
    // said, because a program's own answer outranks the one a hook installs for a page that gave none.
    owned()

    click("#toNote")

    await sleep(1)

    assertEq(went, ["/notes/7?sort=newest"])
    assertEq(location().path, "/notes/7")
    assert(contains(says("view"), "at /notes/7?sort=newest"), says("view"))

@test
async AND_A_CONTROL_ASKING_FOR_THE_QUERY_SEES_THE_MOVE_THE_PAGE_MADE()
    // **The other half: one address bar, read and not copied.** The move here is made by the page's
    // own navigator and not by a click, which is exactly the movement `usePath` never hears about --
    // a hook holding a copy of the path would show the query the page had before, in links a reader is
    // about to click. Every call reads the address bar instead, so any render at all is up to date.
    owned()

    assertEq(says("sort"), "none")

    goes("/notes/7?sort=newest")

    await sleep(1)

    assertEq(location().query, "?sort=newest")
    assertEq(says("sort"), "newest")

@test
async AND_THE_BACK_BUTTON_STILL_REACHES_A_PAGE_THAT_LISTENS_FOR_IT_ITSELF()
    // **`onNavigate` KEEPS ONE HANDLER FOR THE WHOLE PROGRAM.** The `dom` package writes `popped = f`, so
    // the last registration wins -- and a hook that listened for a movement on behalf of a control
    // asking for the query would take the back button off a page that had already asked for it. The
    // page would then hear nothing: the address would move and the view would stay where it was,
    // which is the same symptom the two tests above are about, arriving by the other door.
    owned()

    click("#toNote")

    await sleep(1)

    assertEq(location().path, "/notes/7")

    back()

    await sleep(50)

    assertEq(location().path, "/")

    // **The page heard the movement itself**, which is what the second entry says: the first is the
    // click and the second is the back button arriving at the page's own listener rather than at a
    // hook that had taken the one handler there is.
    assertEq(went, ["/notes/7?sort=newest", "/"])
    assertEq(says("view"), "at /, a note none")

// **What one file installed, put back.** `navigate` is module state for the whole program, so a page
// that said what a link means here would still be saying it in the file that runs next.
@teardown
nobodysNavigator()
    navigateWith(null)

// -- nested routes, against a real document ----------------------------------------------------------

// What the section shows inside its own chrome, as two separate components -- so that moving between
// them is a change the reconciler cannot make by patching text, and the count below is the real cost
// of a nested move rather than the cheapest one.
Body(props: object) = <p id="inner">note {props.id}</p>

Editor(props: object) = <p id="inner">editing {props.id}</p>

// The section's own table. **Nothing in it says where the section is mounted**, and `:id` is bound by
// a template in the other table entirely.
noteRoutes() =
    [{ path: "/", view: (m) -> <Body id={m.params.id}/> },
     { path: "/edit", view: (m) -> <Editor id={m.params.id}/> },
     { path: Anything, view: (m) -> <p id="inner">nothing at {m.path}</p> }]

// The chrome: a heading, two RELATIVE links, a field to put the caret in, and the router below them.
// Everything above the router is what must not be rebuilt when the tail changes.
Section(props: object) =
    val here = useRoute()

    <article id="section">
        <h1 id="title">note {here.params.id}</h1>
        <nav><Link to="edit" id="toEdit">edit</Link><Link to="." id="toRead">read</Link><Link to="/notes/8" id="toEight">eight</Link></nav>
        <input id="keep"/>
        {router(noteRoutes())}
    </article>

nestedRoutes() =
    [{ path: "/", view: (m) -> <p id="view">home</p> },
     { path: "/notes/:id/*", view: (m) -> <Section/> },
     { path: Anything, view: (m) -> <p id="view">nothing at {m.path}</p> }]

Nested(props: object) = router(nestedRoutes(), usePath())

// **`navigateWith(null)` first**, because a page that said what a link means says it for the whole
// program: the tests above install one, and this arrangement is the ordinary one where `usePath`
// moves the address itself.
freshNested(from: string) =
    navigateWith(null)
    pushPath(from)
    at("")

    mount(<Nested/>, domHost("#page"))

@test
async A_NESTED_LINK_IS_RESOLVED_AGAINST_THE_ROUTE_AND_THE_PAGE_RENDERS_BOTH_LEVELS()
    freshNested("/notes/7")

    assertEq(says("title"), "note 7")
    assertEq(says("inner"), "note 7")
    assert(contains(shown(), "href=\"/notes/7/edit\""), shown())
    assert(contains(shown(), "href=\"/notes/7\""), shown())

@test
async A_CLICK_INSIDE_A_NESTED_ROUTER_CHANGES_THE_TAIL_AND_NOTHING_ABOVE_IT()
    // **The claim nesting is worth having for**, and it is measured twice. The counts say the page
    // was changed by the size of the change and not the size of the view; the caret says the chrome
    // is the SAME nodes and not a faithful copy of them, which a count alone cannot tell.
    freshNested("/notes/7")

    focus(byId("keep"))

    // **The baseline is taken after the first turn**, the mount's own effects and the address hook's
    // first state settling one tick after the render that made them.
    await sleep(1)

    val records = mutations()
    val nodes = touched()

    click("#toEdit")

    await sleep(1)

    assertEq(location().path, "/notes/7/edit")
    assertEq(says("inner"), "editing 7")
    assertEq(says("title"), "note 7")

    // **One node out and one node in, in two records**, which is the whole of what changed: `Body`
    // and `Editor` are two components, so the tail is rebuilt and everything above it is left alone.
    // A router that re-rendered the section would have moved the heading, the three anchors and the
    // field as well.
    assertEq(touched() - nodes, 2)
    assertEq(mutations() - records, 2)

    // And the caret never moved, which is what says the field was not rebuilt underneath it.
    assertEq(active(), "keep")

@test
async A_LINK_THAT_CHANGES_A_PARAMETER_ABOVE_CHANGES_BOTH_LEVELS()
    // The other half of the same claim: what the outer template binds is not frozen by nesting, and
    // an absolute link that moves it moves the heading and the tail together.
    freshNested("/notes/7")

    await sleep(1)

    click("#toEight")

    await sleep(1)

    assertEq(location().path, "/notes/8")
    assertEq(says("title"), "note 8")
    assertEq(says("inner"), "note 8")
    assert(contains(shown(), "href=\"/notes/8/edit\""), shown())

@test
async THE_HISTORY_BUTTONS_WALK_A_NESTED_PATH_THE_WAY_THEY_WALK_ANY_OTHER()
    // **A nested move is an ordinary history entry**, because a `Link` pushes whatever level it was
    // written at and the router is a function of the whole path either way.
    freshNested("/notes/7")

    click("#toEdit")

    await sleep(1)

    assertEq(location().path, "/notes/7/edit")

    click("#toRead")

    await sleep(1)

    assertEq(location().path, "/notes/7")
    assertEq(says("inner"), "note 7")

    back()

    await sleep(50)

    assertEq(location().path, "/notes/7/edit")
    assertEq(says("inner"), "editing 7")

    forward()

    await sleep(50)

    assertEq(location().path, "/notes/7")
    assertEq(says("inner"), "note 7")

@test
async A_TAIL_NOTHING_IN_THE_SECTION_MATCHES_IS_THE_SECTIONS_OWN_LAST_CASE()
    // The outer router committed to `/notes/:id/*` at the first segment, so the page's `"*"` never
    // sees this -- the section's does, inside the chrome the section had already drawn.
    freshNested("/notes/7/nowhere")

    assertEq(says("title"), "note 7")
    assertEq(says("inner"), "nothing at /notes/7/nowhere")

import { createElement, Fragment, mount, flush, useState } from "../lath.slx"
import { domHost } from "../dom.slx"
import { byId, query, markup, setProperty } from slate:dom
import { at, mutations, touched, focus, active } from "./probe.slx"

// A long list reordered, watched by the browser rather than by the framework.
//
// **`tests/reconcile.slx` counts what the host was ASKED for and this counts what the page
// RECORDED**, and the two are different measurements: a host that was handed three operations and
// then rebuilt the whole list would pass the first and fail the second. Both are needed, and this is
// the one that cannot be written without a document.

val rows = 1000

names(shift: integer) -> array =
    var out = []

    for i in 0..<rows
        push(out, "r" + string((i + shift) % rows))

    out

// The list, mounted into the page, and the setter that changes which rows there are.
listing() -> object =
    var setter = null

    row(name) = <li key={name} id={"row-" + name}>{name}</li>

    List(props: object) =
        val [keys, set] = useState(names(0))

        setter = set

        <ul id="rows">{keys.map(row)}</ul>

    at("")

    { root: mount(<List/>, domHost("#page")), to: setter }

// The same list, with rows a caret can be put in.
//
// **Separate from `listing` rather than a `tabindex` added to it**, because the markup that list
// produces is asserted character for character two tests below.
focusable() -> object =
    var setter = null

    row(name) = <li key={name} id={"row-" + name} tabindex="0">{name}</li>

    List(props: object) =
        val [keys, set] = useState(names(0))

        setter = set

        <ul id="rows">{keys.map(row)}</ul>

    at("")

    { root: mount(<List/>, domHost("#page")), to: setter }

@test
async REORDERING_THREE_ROWS_OF_A_THOUSAND_IS_SIX_MUTATIONS_AND_NOT_A_THOUSAND()
    // **THE BOUND IS THE SIZE OF THE CHANGE AND NO LONGER THE SIZE OF THE LIST, AND THAT IS THE
    // WHOLE OF WHAT 0.5.0 BOUGHT HERE.** The reconciler has always decided on three operations --
    // `tests/reconcile.slx` pins exactly which three -- and until slate 0.0.30 the DOM host had no
    // `insertBefore` to apply them with: it applied them to a list it kept and wrote that list with
    // `replaceChildren`, which the browser records as a thousand rows leaving and a thousand
    // arriving. `insertBefore` and `removeChild` are what closed that, and the number below is the
    // measurement of it.
    //
    // **Two records per row moved**, a browser reporting a move as a removal and an insertion, and
    // **nothing at all for the nine hundred and ninety-seven rows that stayed**. The old bound was
    // `rows + 2`, which this is a hundred and sixty times inside.
    val it = listing()

    await sleep(1)

    val records = mutations()
    val moved = touched()

    // The last three rows moved to the front, and nothing else changed.
    it.to(names(rows - 3))

    flush(it.root)

    await sleep(1)

    assertEq(mutations() - records, 6)

    // **And six NODES touched**, which is the half a record count cannot say: one whole-list write is
    // a single record that moves two thousand nodes.
    assertEq(touched() - moved, 6)

@test
async THE_ROWS_ARE_MOVED_AND_NOT_REBUILT()
    // **Node identity is the thing a record count cannot say.** A row is marked by writing into it
    // from outside the framework -- which lath knows nothing about -- so the mark survives a move and
    // could not survive a rebuild.
    val it = listing()

    await sleep(1)

    setProperty(byId("row-r0"), "innerHTML", "<b>marked</b>")

    it.to(names(rows - 3))

    flush(it.root)

    await sleep(1)

    assert(contains(markup(byId("rows")), "<b>marked</b>"), "the marked row was rebuilt")

    // And it moved: three rows now stand in front of it.
    assert(contains(markup(byId("rows")),
        "<li id=\"row-r997\">r997</li><li id=\"row-r998\">r998</li><li id=\"row-r999\">r999</li>"))

@test
async A_RENDER_THAT_CHANGES_NOTHING_TOUCHES_THE_PAGE_NOT_AT_ALL()
    // **The claim the whole diff rests on**, said where the browser can answer it: a re-render with
    // the same rows is not a whole child list written back over itself.
    val it = listing()

    await sleep(1)

    val moved = touched()

    it.to(names(0))

    flush(it.root)

    await sleep(1)

    assertEq(touched() - moved, 0)

@test
async THE_CARET_STAYS_IN_A_ROW_THAT_MOVED()
    // **What a whole-list write costs a person, said as the browser sees it.** `replaceChildren`
    // takes every row out of the page and puts it back, and a row taken out of the page loses the
    // caret -- so somebody typing in the third row of a list that reorders underneath them was
    // silently thrown out of the field. A moved node keeps it, and that is `insertBefore`'s own rule
    // rather than anything the framework arranges.
    //
    // **jsdom answers this and cannot answer the neighbouring question**: it is a faithful DOM and
    // not a rendering engine, so there is no layout and a scroll position is always zero. Focus is
    // the half of "the row survived intact" that a document without layout can be asked.
    // **The rows carry a `tabindex` so that they can hold the caret at all**, jsdom refusing to focus
    // an element a browser would refuse to focus. It is the one difference from the list above.
    val it = focusable()

    await sleep(1)

    focus(byId("row-r0"))

    assertEq(active(), "row-r0")

    it.to(names(rows - 3))

    flush(it.root)

    await sleep(1)

    assertEq(active(), "row-r0")

@test
async A_ROW_TAKEN_OUT_IS_ONE_REMOVAL_AND_NOT_A_REWRITE()
    // The other operation, measured the same way. **One record and one node**, where a whole-list
    // write is a record naming every row in the list.
    val it = listing()

    await sleep(1)

    val records = mutations()
    val moved = touched()

    var short = names(0)

    removeAt(short, 500)

    it.to(short)

    flush(it.root)

    await sleep(1)

    assertEq(mutations() - records, 1)
    assertEq(touched() - moved, 1)

// What a test can ask a real document.
//
// **The `dom` package answers all but one of these itself.** `dispatch` sends an event and `observe`
// counts what the page recorded, so what used to be a property setter installed on
// `Element.prototype` and a `MutationObserver` in `setup.mjs` is now two ordinary calls in this
// file. The one thing left in the harness is the count of navigations jsdom refused, which is read
// off its console and could not be anything a page has a name for.
//
// **Nothing here fakes anything.** jsdom builds the event, jsdom dispatches it, jsdom's own
// `MutationObserver` counts what changed. This file is the wire, not the answer.

import { byId, query, markup, nodeText, attribute, setProperty, focus as domFocus, activeElement,
    tagName, dispatch, observe } from dom

// The page emptied, with whatever a server would have sent already inside the container.
//
// **`innerHTML` is how markup gets onto a page, and there is no other way from here.** The `dom`
// package deliberately has no reader for it and no writer either; `setProperty` is a property assignment on
// a real element, which is what this is. It is what makes a hydration test possible at all: the
// markup has to be PARSED by the browser, and a tree built out of `createElement` is not the same
// page.
export at(inside: string) =
    setProperty(query("body"), "innerHTML", "<div id=\"page\">" + inside + "</div>")

    null

// The page emptied, with something else BESIDE the container.
//
// **A portal's destination has to be outside the tree the application renders into**, the container's
// children being what a mount replaces -- so it goes here rather than in `at`.
export beside(extra: string) =
    setProperty(query("body"), "innerHTML", "<div id=\"page\"></div>" + extra)

    null

// The container every test renders into.
export container() = byId("page")

// What the container holds now, as markup.
export shown() -> string = markup(container())

// The element the harness publishes its one count on. It is in the HEAD, so that writing to it is
// not itself a mutation of the page being watched.
probe() = byId("lath-probe")

// **`number` and not `integer`, which reads a number out of a string where `integer` converts one
// that is already a number.** An attribute is text, always.
count(name: string) -> integer =
    val said = attribute(probe(), name)

    if said == null then 0 else integer(number(said))

// What the page has recorded since this module was imported.
//
// **Running totals and not readings that reset**, so a test takes one before and after and
// subtracts -- which is the only shape that works when every test in this directory shares one
// document.
var records = 0
var moved = 0

counted(list: array) =
    for r in list
        records = records + 1

        if r.type == "children" then moved = moved + r.added + r.removed else moved = moved + 1

    null

// How many mutation RECORDS the browser has made for the page so far.
export mutations() -> integer = records

// How many NODES those records added or removed, plus one for each attribute or text change.
//
// **The pair is the measurement.** A hydrated page has to record nothing at all, which the count of
// records says; a reorder that replaces a whole child list makes ONE record and moves a thousand
// nodes, which only this says.
export touched() -> integer = moved

// How many clicks the browser was allowed to follow, which is how many the router declined.
//
// **The one thing still read off the harness**, and it is not a page's answer at all: jsdom raises
// *"Not implemented: navigation to another Document"* on its console when a click on an anchor is
// left alone, so counting those is counting what a real browser would have done and jsdom would not.
export navigations() -> integer = count("data-navigations")

// Whether the last event dispatched had its default prevented. `dispatch` answers whether NOTHING
// cancelled the event, which is the same fact the other way up.
var cancelled = false

export prevented() -> boolean = cancelled

// An event dispatched on a node -- by the browser, and shaped as a person's would be.
//
//     fire(node, "click")
//     fire(node, "click meta")
//     fire(node, "click button=1")
//     fire(node, "keydown key=Enter")
export fire(node, spec: string) =
    cancelled = !dispatch(node, eventOf(spec))

    null

// The spec above, as the record `dispatch` reads: the type, then the modifiers and the one-word
// settings a test writes after it.
eventOf(spec: string) -> object =
    val parts = split(spec, " ")
    var meta = false
    var ctrl = false
    var shift = false
    var alt = false
    var button = null
    var key = null

    for i in 1..<parts.length
        val part = parts[i]
        val eq = indexOf(part, "=")

        if part == "" then continue

        if eq == null
            if part == "meta" then meta = true
            elif part == "ctrl" then ctrl = true
            elif part == "shift" then shift = true
            elif part == "alt" then alt = true
            else throw "there is no event modifier called " + part
        elif part[0..<eq] == "button"
            button = integer(number(part[eq + 1..<part.length]))
        elif part[0..<eq] == "key"
            key = part[eq + 1..<part.length]
        else
            throw "there is nothing an event takes called " + part[0..<eq]

    { type: parts[0], mods: { meta: meta, ctrl: ctrl, shift: shift, alt: alt },
        button: button, key: key }

// The same, on the first node matching a selector.
export click(selector: string, spec: string = "click") =
    val node = query(selector)

    if node == null
        throw "there is nothing matching " + selector + " on the page to click"

    fire(node, spec)

    null

// What an element says, or a sentence saying it is not there -- so that a missing node reads as a
// value rather than faulting three lines after the mistake.
export says(id: string) -> string =
    val node = byId(id)

    if node == null then "<gone>" else nodeText(node)

// The caret put in a node, by the browser. **The package's own `focus`** -- what it is for is the
// claim a surgical reorder makes and a whole-list write cannot: a row that
// moved keeps the caret and a row that was rebuilt does not.
export focus(node) =
    domFocus(node)

    null

// The id of the element the caret is in, or empty where it is nowhere. **Read straight off
// `activeElement()`**, not off a republished attribute. It answers the id (falling back to the tag)
// rather than the node itself: a node prints as `<external HTMLInputElement>`, which names no
// element, and a test that fails has to be able to say WHICH one the caret was in.
export active() -> string =
    val on = activeElement()

    if on == null then "" else (attribute(on, "id") ?? tagName(on) ?? "")

// What the document's HEAD holds, as markup.
//
// **Where a stylesheet goes**, and the one place `shown()` cannot look: the container is in the body
// and the observer watches the body, so a `<style>` put in the head is invisible to both.
export inHead() -> string =
    val node = query("head")

    markup(node)

// **The watch is installed AT IMPORT**, the way `dom.slx` installs its navigator: every test in this
// directory shares one document and reads the counts as a difference, so the observer has to be
// running before the first of them renders anything.
//
// **It watches the BODY and nothing above it**, which is what leaves the head free: the one count
// the harness still publishes goes on a `<meta>` up there, where writing it is not a mutation this
// would see.
observe(query("body"), { children: true, attributes: true, text: true, subtree: true }, counted)

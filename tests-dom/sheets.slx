import "./sheets-dom.css"
import { createElement, Fragment, mount, hydrate, html, flush, style, useState } from "../lath.slx"
import { domHost } from "../dom.slx"
import { at, shown, inHead, mutations } from "./probe.slx"
import bare from "./sheets-dom.css"

// A program's bare-imported stylesheet against a real document: written by the server in front of
// the component sheets, adopted by a hydrating page without a single mutation, and kept first.
//
// **The order is the cascade's**: the app's global css, then each component's own, so a component's
// rule wins a tie. Hydration must not reorder it and must not write a second copy.

countOf(s: string, sub: string) -> integer =
    var found = 0
    var from = 0

    while true
        val at = indexOf(s[from..], sub)

        if at == null then break

        found = found + 1
        from = from + at + sub.length

    found

before(s: string, a: string, b: string) -> boolean =
    val x = indexOf(s, a)
    val y = indexOf(s, b)

    x != null && y != null && x < y

@test
async A_HYDRATED_PAGE_KEEPS_ONE_COPY_OF_EACH_SHEET_IN_ORDER_AND_RECORDS_NOTHING()
    val own = ".dom-bare-card { color: rgb(31, 31, 31); }"

    Card(props: object) =
        style(own)

        <p id="bare-card">a card</p>

    val sent = html(mount(<Card/>))

    assert(before(sent, bare, own))

    at(sent)

    await sleep(1)

    val records = mutations()

    hydrate(<Card/>, domHost("#page"))

    await sleep(1)

    assertEq(mutations() - records, 0)

    assertEq(countOf(shown(), bare), 1)
    assertEq(countOf(shown(), own), 1)
    assert(before(shown(), bare, own))

    assertEq(countOf(inHead(), bare), 0)
    assertEq(countOf(inHead(), own), 0)

@test
async THE_ORDER_SURVIVES_A_LATER_CHANGE_TO_THE_TOP_OF_THE_TREE()
    val own = ".dom-bare-shell { color: rgb(32, 32, 32); }"
    val later = ".dom-bare-later { color: rgb(33, 33, 33); }"

    var setter = null

    Shell(props: object) =
        val [more, setMore] = useState(false)

        setter = setMore

        style(own)

        if more then style(later)

        <>
            <p id="bare-kept">kept</p>
            {more && <p id="bare-extra">extra</p>}
        </>

    at(html(mount(<Shell/>)))

    val root = hydrate(<Shell/>, domHost("#page"))

    setter(true)
    flush(root)

    await sleep(1)

    assertEq(countOf(shown(), bare), 1)
    assertEq(countOf(shown(), own), 1)
    assert(before(shown(), bare, own))
    assert(contains(shown(), "id=\"bare-extra\""))

    // A sheet first registered after hydration goes where any new sheet goes, the head; the bare one
    // the server sent is not written there a second time.
    assertEq(countOf(inHead(), later), 1)
    assertEq(countOf(inHead(), bare), 0)

@test
A_FRESH_MOUNT_PUTS_THE_BARE_SHEET_IN_THE_HEAD_AHEAD_OF_A_COMPONENTS_ONCE()
    // **No server here**, so the head is where both go -- the bare sheet first. A second mount on the
    // same page finds it already there.
    val own = ".dom-bare-fresh { color: rgb(34, 34, 34); }"

    Fresh(props: object) =
        style(own)

        <p id="bare-fresh">fresh</p>

    at("")
    mount(<Fresh/>, domHost("#page"))

    assertEq(countOf(inHead(), bare), 1)
    assert(before(inHead(), bare, own))

    at("")
    mount(<Fresh/>, domHost("#page"))

    assertEq(countOf(inHead(), bare), 1)
    assertEq(countOf(inHead(), own), 1)
    assert(!contains(shown(), "<style"))

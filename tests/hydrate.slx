import { createElement, Fragment, mount, hydrate, html, flush, stringHost, style, useState,
    Boundary } from "../lath.slx"

// Hydration: the same render, taking the nodes already there instead of creating them.
//
// **THE HOST HERE IS A PAGE THE TEST BUILT, AND THAT IS LEGITIMATE WHERE A FAKE DOCUMENT WOULD NOT
// BE.** What these pin is the RECONCILER's half -- the order it adopts in, the count it insists on,
// and the sentence a mismatch produces -- none of which is about what a real DOM does. The DOM host's
// half is checked against jsdom in `check/`, where a document written beside the code it checks would
// agree with that code by construction and prove nothing.
//
// **The host counts what it was made to do**, which is the measurement: a hydrated page creates
// nothing, sets no child list, and writes no attribute that was already right.

// A node of the little page these tests hydrate against. An element, or text.
//
// **The `id` is what makes two nodes two nodes.** slate compares objects structurally, so a page with
// the same text in two places would otherwise hand the reconciler one node twice -- which is the same
// reason `stringHost`'s nodes carry one.
var minted = 0

fresh() -> integer =
    minted = minted + 1

    minted

tag(name: string, attrs: object, kids: array) -> object =
    { id: fresh(), tag: name, attrs: attrs, kids: kids }

words(s: string) -> object = { id: fresh(), tag: null, attrs: {}, kids: [], text: s }

// A host over a page the test built, counting everything it was asked to change.
pageHost(top: array) =
    val seen = { made: 0, wrote: 0, put: 0, took: 0, text: 0, mounts: 0, styles: 0, sheets: [], adopted: [] }
    val root = tag("#root", {}, top)

    made(node) =
        seen.made = seen.made + 1

        node

    element(name: string) = made(tag(name, {}, []))

    text(s: string) = made(words(s))

    setProps(node: object, props: object) =
        for [name, value] in entries(props)
            if name == "children" || name == "key" then continue
            if isOn(name) then continue

            // **Comparing before writing is what the zero-mutation claim rests on**, and it is the
            // DOM host's rule too rather than something this test invented.
            if (node.attrs[name] ?? null) != value
                node.attrs[name] = value
                seen.wrote = seen.wrote + 1

        null

    // **What CHANGED where there was once a whole child list**, and the counts are the measurement:
    // a hydrated page is handed nothing at all, every child having been adopted from its parent in
    // order.
    patch(parent: object, ops: array) =
        for op in ops
            val was = parent.kids.indexOf(op.node)

            if was != null then removeAt(parent.kids, was)

            if op.kind == "remove"
                seen.took = seen.took + 1
            else
                val to = if op.before == null then null else parent.kids.indexOf(op.before)

                if to == null then push(parent.kids, op.node) else insert(parent.kids, to, op.node)

                seen.put = seen.put + 1

        null

    setNodeText(node: object, s: string) =
        if node.text != s
            node.text = s
            seen.text = seen.text + 1

        null

    serialise(nodes: array) -> string =
        var out = ""

        for node in nodes
            out = out + draw(node)

        out

    drop(node) = null

    mounted(nodes: array) =
        seen.mounts = seen.mounts + 1

        null

    adopt(parent, index: integer) =
        val kids = (parent ?? root).kids

        if index >= kids.length then return null

        val node = kids[index]

        { node: node, tag: node.tag, text: node.text ?? "" }

    // **Counted rather than applied**, which is the same measurement the rest of this host makes: a
    // hydrating render must ask for nothing at all, the markup it is standing on already carrying a
    // `<style>` for every sheet the first render registers.
    styles(list: array) =
        seen.styles = seen.styles + 1
        seen.sheets = list

        null

    { element: element, text: text, setProps: setProps, setText: setNodeText,
      serialise: serialise, drop: drop, mounted: mounted, adopt: adopt,
      patch: patch, styles: styles, where: "page", seen: seen }

isOn(name: string) -> boolean =
    name.length > 2 && name[0..<2] == "on" && name[2] == name[2].upper()

draw(node: object) -> string =
    if node.tag == null then return node.text

    var out = "<" + node.tag + ">"

    for kid in node.kids
        out = out + draw(kid)

    out + "</" + node.tag + ">"

// The page a matching render would have produced: `<p class="a">hello<b>there</b></p>`.
page() -> array =
    [tag("p", { class: "a" }, [words("hello"), tag("b", {}, [words("there")])])]

Same(props: object) = <p class="a">hello<b>there</b></p>

fell(f) -> string =
    var said = ""

    try
        f()
    catch e
        said = e.message

    said

@test
A_HYDRATED_PAGE_CREATES_NOTHING_AND_SETS_NO_CHILD_LIST()
    // **This is the whole of what hydration is for.** A render that built the tree would create four
    // nodes and set two child lists; adopting makes neither, and the counts are the measurement.
    val host = pageHost(page())

    hydrate(<Same/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.put, 0)
    assertEq(host.seen.took, 0)
    assertEq(host.seen.text, 0)

@test
AN_ATTRIBUTE_THAT_IS_ALREADY_RIGHT_IS_NOT_WRITTEN_AGAIN()
    // **An attribute written to the value it already holds is a mutation** an observer sees, styles
    // recompute for, and a screen reader announces. The host compares first, and so does the DOM one.
    val host = pageHost(page())

    hydrate(<Same/>, host)

    assertEq(host.seen.wrote, 0)

@test
AN_ATTRIBUTE_THAT_IS_WRONG_IS_THE_ONE_THING_A_HYDRATION_DOES_WRITE()
    // A mismatched attribute is not a mismatched TREE: the shape is right and one value is stale, so
    // the render corrects it rather than refusing. That is the line between the two.
    val host = pageHost([tag("p", { class: "stale" }, [words("hello"), tag("b", {}, [words("there")])])])

    hydrate(<Same/>, host)

    assertEq(host.seen.wrote, 1)
    assertEq(host.seen.made, 0)

@test
A_MOUNTED_RENDER_MAKES_EVERYTHING_A_HYDRATED_ONE_ADOPTS()
    // **The control.** Without it the counts above could be zero because nothing ran at all, which is
    // the way a measurement of "did nothing" fails.
    val host = pageHost([])

    mount(<Same/>, host)

    assertEq(host.seen.made, 4)

    // The `<b>`'s one child, and the `<p>`'s two: three children put where they go, and nothing
    // taken out. A render that replaced a whole child list would say two, whatever the lists held.
    assertEq(host.seen.put, 3)
    assertEq(host.seen.took, 0)

@test
A_TAG_THAT_DOES_NOT_MATCH_IS_A_FAULT_NAMING_THE_PATH_AND_BOTH_SIDES()
    // **A mismatch faults and there is no falling back to a client render.** A page that quietly
    // rebuilt what it could not adopt would hide a server and a client that disagree, which is the
    // defect hydration exists to expose.
    val host = pageHost([tag("div", { class: "a" }, [words("hello"), tag("b", {}, [words("there")])])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(contains(said, "at page > 0"))
    assert(contains(said, "the tree wants <p>"))
    assert(contains(said, "the page has <div>"))

@test
THE_PATH_COUNTS_DOWN_THROUGH_THE_TREE()
    // `page > 0 > 1` is the second child of the first child of the container, which is where the `<b>`
    // is. A path that only ever named the top would send the reader to the wrong element.
    val host = pageHost([tag("p", { class: "a" }, [words("hello"), tag("i", {}, [words("there")])])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(contains(said, "at page > 0 > 1"))
    assert(contains(said, "wants <b>"))
    assert(contains(said, "has <i>"))

@test
TEXT_THAT_DOES_NOT_MATCH_IS_A_FAULT_AND_SAYS_BOTH_STRINGS()
    val host = pageHost([tag("p", { class: "a" }, [words("goodbye"), tag("b", {}, [words("there")])])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(contains(said, "at page > 0 > 0"))
    assert(contains(said, "wants the text \"hello\""))
    assert(contains(said, "has the text \"goodbye\""))

@test
AN_ELEMENT_WHERE_TEXT_WAS_WANTED_SAYS_SO_RATHER_THAN_COMPARING_STRINGS()
    val host = pageHost([tag("p", { class: "a" }, [tag("em", {}, []), tag("b", {}, [words("there")])])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(contains(said, "wants the text \"hello\""))
    assert(contains(said, "has <em>"))

@test
MARKUP_THAT_RAN_OUT_IS_A_FAULT_AND_NOT_A_QUIET_BUILD()
    // **The commonest real mismatch**, and the one a fallback would hide best: a server that rendered
    // less than the client wants leaves a page that is simply missing things.
    val host = pageHost([tag("p", { class: "a" }, [words("hello")])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(contains(said, "at page > 0 > 1"))
    assert(contains(said, "the page has nothing -- the markup ran out"))

@test
MARKUP_WITH_MORE_IN_IT_THAN_THE_TREE_WANTED_IS_A_FAULT_TOO()
    // **The other half, and it is the one nothing else would ever notice.** An extra node adopted by
    // nothing and updated by nothing stays on the page for the life of the program.
    val extra = [tag("p", { class: "a" },
        [words("hello"), tag("b", {}, [words("there")]), tag("span", {}, [])])]
    val said = fell(() -> hydrate(<Same/>, pageHost(extra)))

    assert(contains(said, "at page > 0 > 2"))
    assert(contains(said, "the tree wants nothing more"))
    assert(contains(said, "the page has <span>"))

@test
AND_AT_THE_TOP_AS_WELL_AS_INSIDE()
    val said = fell(() -> hydrate(<Same/>, pageHost([page()[0], tag("hr", {}, [])])))

    assert(contains(said, "at page > 1"))
    assert(contains(said, "wants nothing more"))
    assert(contains(said, "has <hr>"))

@test
A_STRING_HOST_REFUSES_TO_HYDRATE_RATHER_THAN_ANSWERING_NOTHING()
    // **A server is what renders the markup a page hydrates and never hydrates anything itself.**
    // Answering `null` here would make `hydrate` fall back to building the tree, silently — which is
    // the failure this whole item exists to make loud.
    val said = fell(() -> hydrate(<Same/>, stringHost()))

    assert(contains(said, "a string host has nothing to hydrate"))

@test
A_HYDRATED_TREE_STILL_RENDERS_WHEN_ITS_STATE_CHANGES()
    // **Hydration is the first render and not a different kind of tree.** Everything after it is an
    // ordinary render, which is what makes the handlers it attached worth attaching.
    val host = pageHost([tag("p", {}, [words("0")])])

    Counter(props: object) =
        val [n, setN] = useState(0)

        <p>{string(n)}</p>

    val root = hydrate(<Counter/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.text, 0)
    assertEq(host.serialise([host.adopt(null, 0).node]), "<p>0</p>")

@test
A_HYDRATING_RENDER_HANDS_ITS_SHEETS_OVER_LIKE_ANY_OTHER()
    // **The stylesheets are already on the page, and writing them again is the one thing a hydrated
    // page must not do** -- a duplicated rule is worse than a wasted write, because it changes what
    // the cascade does. **What makes that free is the host and not a flag**: it is handed the list
    // and compares it against what the page carries, which is the rule `setProps` and `setText`
    // already follow. `tests-dom/style.slx` is where that comparison is measured against a real
    // document; what this pins is the framework's half -- one call per change to the list, and the
    // WHOLE list every time, so that a host has something to compare against.
    var setter = null

    Styled(props: object) =
        val [open, setOpen] = useState(false)

        setter = setOpen

        style(".a { color: red; }")

        if open then style(".b { color: blue; }")

        <p class="a">hello<b>there</b></p>

    val host = pageHost(page())
    val root = hydrate(<Styled/>, host)

    // **Told once, on the hydrating commit, exactly as a mounting one is told.** What makes that
    // free is the HOST: it compares the list against what the page already carries and writes
    // nothing, which is the same rule that keeps an attribute already right from being written
    // again. This host records the call so that the count below means something.
    assertEq(host.seen.styles, 1)
    assertEq(host.seen.sheets, [".a { color: red; }"])

    // A render after the hydrating one that registers nothing new asks for nothing either.
    setter(false)
    flush(root)

    assertEq(host.seen.styles, 1)

    // And one that registers a new sheet is handed the WHOLE list, the newest last -- which is what
    // lets a host work out for itself which of them the page already carries.
    setter(true)
    flush(root)

    assertEq(host.seen.styles, 2)
    assertEq(host.seen.sheets, [".a { color: red; }", ".b { color: blue; }"])

// -- text, which is where the markup and the tree can stop agreeing -------------------------------

// **THE MARKUP IS WHAT BOTH SIDES HAVE TO AGREE ABOUT, AND IT CANNOT SAY EVERYTHING A TREE CAN.**
// Two text children in a row write one run of characters, and an empty one writes nothing at all --
// so a tree holding two text nodes, or one empty node, asks the page for something no parser could
// have made. Both are settled in the TREE rather than in the markup: a run is joined before an
// instance is made, and an empty text child stands for no node in either host.

Adjacent(props: object) = <h2>{2} replies</h2>

Empty(props: object) = <p>{""}</p>

@test
A_RUN_OF_TEXT_CHILDREN_IS_ONE_NODE_IN_THE_TREE_BECAUSE_IT_IS_ONE_IN_THE_MARKUP()
    // Two children in the source, one text node made: `<h2>` and the run under it, and one child put
    // where it goes. A tree that made two would be a tree the markup cannot describe.
    val host = pageHost([])
    val root = mount(<Adjacent/>, host)

    assertEq(host.seen.made, 2)
    assertEq(host.seen.put, 1)
    assertEq(html(root), "<h2>2 replies</h2>")

@test
A_RUN_OF_TEXT_CHILDREN_ADOPTS_THE_ONE_NODE_A_PARSER_MADE()
    // **The defect this closes.** The page has `<h2>2 replies</h2>`, which is one text node; lath
    // used to want the text `"2"` there and fault on what it found.
    val host = pageHost([tag("h2", {}, [words("2 replies")])])

    hydrate(<Adjacent/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.text, 0)
    assertEq(host.seen.put, 0)
    assertEq(host.seen.took, 0)

@test
A_TEXT_CHILD_BESIDE_A_COMPONENT_THAT_RENDERS_TEXT_IS_THE_ONE_RUN_THAT_CANNOT_BE_JOINED()
    // **The error path, and it is a real limit rather than an oversight**: the two halves live in
    // different instances, each with its own node to update, so nothing can join them without one of
    // them owning half of somebody else's text node. The message says so where the reader is looking,
    // and the answer is a single expression -- `<p>{"hello " + name}</p>`.
    Name(props: object) = "ed"

    Greeting(props: object) = <p>hello <Name/></p>

    val host = pageHost([tag("p", {}, [words("hello ed")])])
    val said = fell(() -> hydrate(<Greeting/>, host))

    assert(contains(said, "at page > 0 > 0"))
    assert(contains(said, "wants the text \"hello \""))
    assert(contains(said, "has the text \"hello ed\""))
    assert(contains(said, "beside a component that renders text"))

@test
A_TEXT_MISMATCH_THAT_IS_NOT_A_JOINED_RUN_SAYS_NOTHING_ABOUT_ONE()
    // **The hint is for the case it is about and no other.** A server that rendered different words
    // is an ordinary mismatch, and pointing its reader at text children in a row would send them
    // looking for something that is not there.
    val host = pageHost([tag("p", { class: "a" }, [words("goodbye"), tag("b", {}, [words("there")])])])
    val said = fell(() -> hydrate(<Same/>, host))

    assert(!contains(said, "beside a component"))

@test
AN_EMPTY_TEXT_CHILD_MAKES_NO_NODE_AT_ALL()
    // One node made -- the `<p>` -- and nothing put inside it, because there is nothing to put.
    val host = pageHost([])
    val root = mount(<Empty/>, host)

    assertEq(host.seen.made, 1)
    assertEq(host.seen.put, 0)
    assertEq(html(root), "<p></p>")

@test
AN_EMPTY_TEXT_CHILD_HYDRATES_AGAINST_MARKUP_WITH_NOTHING_IN_IT()
    // **The second defect this closes.** `<p>{""}</p>` serialises to `<p></p>`, so a tree wanting a
    // text node there faulted with *the page has nothing -- the markup ran out*.
    val host = pageHost([tag("p", {}, [])])

    hydrate(<Empty/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.put, 0)
    assertEq(host.seen.text, 0)

@test
TEXT_THAT_STOPS_BEING_EMPTY_ARRIVES_AS_A_NODE_AND_LEAVES_AGAIN_WHEN_IT_GOES()
    // **A text child holds a node exactly while there is text in it**, which is the other half of
    // the rule above: the node is made on the render that fills it and given back on the render that
    // empties it, and the ordinary child diff puts it in and takes it out.
    var setter = null

    Note(props: object) =
        val [said, setSaid] = useState("")

        setter = setSaid

        <p>{said}</p>

    val host = pageHost([tag("p", {}, [])])
    val root = hydrate(<Note/>, host)

    assertEq(host.seen.made, 0)

    setter("hi")
    flush(root)

    assertEq(host.seen.made, 1)
    assertEq(host.seen.put, 1)
    assertEq(host.serialise([host.adopt(null, 0).node]), "<p>hi</p>")

    setter("")
    flush(root)

    assertEq(host.seen.took, 1)
    assertEq(host.serialise([host.adopt(null, 0).node]), "<p></p>")

// -- a mismatch is not a render fault -------------------------------------------------------------

@test
A_BOUNDARY_DOES_NOT_CATCH_A_HYDRATION_MISMATCH()
    // **A mismatch is a fault in the FRAMEWORK's contract with the server and not in a component**,
    // so it goes past every boundary above it. A boundary that caught one would render its fallback
    // into markup that is not the fallback's -- and the second fault names the fallback's own tree,
    // burying the sentence that said which element actually disagreed. That is a day of looking in
    // the wrong place, and it is why this test exists.
    var shown = false

    Broken(props: object) = <p>x</p>

    fallback(e) =
        shown = true

        <em>caught</em>

    App(props: object) =
        <div><Boundary fallback={fallback}><Broken/></Boundary></div>

    val host = pageHost([tag("div", {}, [tag("span", {}, [words("x")])])])
    val said = fell(() -> hydrate(<App/>, host))

    assert(contains(said, "at page > 0 > 0"))
    assert(contains(said, "the tree wants <p>"))
    assert(contains(said, "the page has <span>"))
    assertEq(shown, false)

@test
A_RENDER_FAULT_UNDER_A_BOUNDARY_IS_STILL_CAUGHT_WHILE_HYDRATING()
    // **The control, and it is what says the rule above is about mismatches and not about boundaries
    // during hydration.** A component that cannot render is exactly what a boundary is for, and a
    // server whose render faulted the same way sent the fallback's markup -- which the fallback then
    // adopts like any other tree.
    Boom(props: object)
        throw "gone"

    App(props: object) =
        <div><Boundary fallback={(e) -> <p class="broken">{e.message}</p>}><Boom/></Boundary></div>

    val host = pageHost([tag("div", {}, [tag("p", { class: "broken" }, [words("gone")])])])

    hydrate(<App/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.wrote, 0)

@test
A_MISMATCH_SOMEBODY_CAUGHT_DOES_NOT_MAKE_THE_NEXT_FAULT_UNCATCHABLE()
    // **The flag that carries a mismatch past a boundary is cleared where a render BEGINS**, not
    // where the fault is caught -- so a program that caught one itself, as the test above does,
    // leaves nothing behind. Without this the next ordinary render fault would walk past the
    // boundary written for it, and it would do so in whatever unrelated code ran next.
    fell(() -> hydrate(<Same/>, pageHost([tag("div", {}, [])])))

    Boom(props: object)
        throw "gone"

    App(props: object) =
        <div><Boundary fallback={(e) -> <p>{e.message}</p>}><Boom/></Boundary></div>

    assertEq(html(mount(<App/>)), "<div><p>gone</p></div>")

@test
AN_EMPTY_TEXT_CHILD_BETWEEN_TWO_ELEMENTS_MOVES_NO_INDEX()
    // **The cursor counts what the page holds and not what the tree wrote**, which is the edge the
    // rule above has to survive: an empty text child claims nothing, so the element after it is the
    // NEXT child of the parent and not the one after that.
    Mixed(props: object) = <p><b>x</b>{""}<i>y</i></p>

    val host = pageHost([tag("p", {}, [tag("b", {}, [words("x")]), tag("i", {}, [words("y")])])])

    hydrate(<Mixed/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.put, 0)
    assertEq(host.seen.took, 0)

@test
A_RUN_OF_TEXT_BETWEEN_ELEMENTS_IS_ONE_CHILD_AND_THE_ELEMENTS_KEEP_THEIR_PLACES()
    // Two runs and one element between them: three children in the page, and the tree counts three.
    Between(props: object) = <p>{1}{2}<b>x</b>{3}{4}</p>

    val host = pageHost([tag("p", {},
        [words("12"), tag("b", {}, [words("x")]), words("34")])])

    hydrate(<Between/>, host)

    assertEq(host.seen.made, 0)
    assertEq(host.seen.text, 0)
    assertEq(host.seen.put, 0)

// The DOM host: the same functions the string host answers, over a real page.
//
// **Nothing above this knows what a node is**, which is the whole of what the adapter buys -- one
// set of components renders to markup beside `slate:http` and into the document in a browser, and
// neither knows about the other. This file is the second implementation, which is what turns that
// claim from a hope into a fact.
//
// **A node here is an INTEGER**, `slate:dom` handing out a handle into a table it keeps rather than
// a foreign value slate could not print, compare or store. So everything below is arithmetic and
// strings, which is what makes it ordinary slate.

import { createElement, createText, setAttribute, removeAttribute, setProperty, on, off,
    setChildren, setText, byId, query, markup, release } from slate:dom
import { children, tagName, nodeText, attribute } from slate:dom
import { location, pushPath, onNavigate } from slate:dom
import { Host, useState, useEffect } from "./lath.slx"
import { navigateWith } from "./router.slx"

// A host over one element of the page.
//
// **`into` is a selector or an `#id`**, those being what a page has to hand:
//
//     mount(<App/>, domHost("#app"))
//
// **The six functions are built HERE rather than at the top level**, because two of them have to
// remember things: what was last set on a node, so that a re-render can take back the attribute it
// no longer has and the handler it replaced. A top-level function would have nowhere to keep that.
// **`-> Host` is the second implementation checked against the contract**, which is the whole reason
// that type is exported. An adapter with one implementation is a guess -- this one shipped with six
// functions and needed eight -- so the one place a missing function can be caught cheaply is here,
// where the object is built.
export domHost(into: string) -> Host =
    val el = if into[0..<1] == "#" then byId(into[1..]) else query(into)

    if el == null
        throw "there is no element matching " + into + " on this page"

    // What was last set on each node, keyed by its handle -- a number, so this is an ordinary
    // object used as a table. Two tables rather than one: an attribute is taken back by name and a
    // handler has to be taken back by the very function that was installed.
    val attrs = {}
    val hands = {}

    // What each parent holds, keyed by its handle, in order.
    //
    // **A cache and not a question asked of the page, because a handle cannot be asked twice.**
    // `children(node)` mints a FRESH handle for every child it answers, so a second call for the same
    // element gives a different number -- and the framework holds the first. There is no way to ask
    // "is this node already in that parent" without remembering, so this remembers.
    //
    // **It is also why `slate:dom`'s lack of an `insertBefore` shows here and nowhere else.** The
    // module can set a whole child list and nothing smaller, so `insert` and `remove` below keep the
    // list themselves and hand the whole of it over. That is correct and it is not surgical: see the
    // note on the two functions.
    val kids = {}

    element(tag: string) = createElement(tag)

    text(s: string) = createText(s)

    // **A re-render sets what is there now and takes back what is not**, which is the half a host
    // that only ever set things would get wrong: a `disabled` that goes away has to be removed, and
    // a handler replaced by a new closure has to be detached or the old one fires too.
    setProps(node: integer, props: object) =
        val key = string(node)
        val had = attrs[key] ?? []
        var now = []

        for [name, value] in entries(props)
            if name == "children" || name == "key" then continue

            if isHandler(name)
                listen(hands, node, name, value)
                continue

            now.push(name)

            // **`value` and `checked` are PROPERTIES and not attributes**, and an input is where the
            // difference shows: the attribute says what the field started as and the property says
            // what it holds now, so a re-render setting the attribute would leave a typed-in field
            // alone and the page would appear frozen.
            if name == "value" || name == "checked"
                setProperty(node, name, value)
            elif attribute(node, name) != value
                // **Comparing before setting is what makes a hydrated page make no mutations at
                // all**, and it is worth having on every render and not only the first: an attribute
                // written to the value it already holds is a mutation observers see, styles
                // recompute for, and a screen reader announces. `attribute` answers `true` for a bare
                // attribute, which is exactly what `setAttribute` writes for one, so the two agree.
                setAttribute(node, name, value)

        for name in had
            if !now.contains(name) then removeAttribute(node, name)

        attrs[key] = now

        null

    // The children of one parent, as this host last left them.
    held(node: integer) -> array =
        val key = string(node)
        val list = kids[key] ?? null

        if list != null then return list

        val fresh = []

        kids[key] = fresh

        fresh

    // What changed about a parent's children, applied and then written once.
    //
    // **`slate:dom` HAS NO `insertBefore`, AND THAT IS WHY THIS TAKES A BATCH.** `setChildren` is
    // `replaceChildren` and is the only way this module has of changing what a node holds, so the
    // operations are applied to the list kept above -- ordinary arithmetic on integers -- and the
    // page is written once at the end. Told one operation at a time, a list filled with a thousand
    // rows would be a thousand whole-list writes.
    //
    // **What is still owed is the write itself**: a reorder of three rows out of a thousand is three
    // correct operations and one `replaceChildren` of a thousand nodes. The framework above is
    // already surgical -- `tests/reconcile.slx` pins the exact operations -- and two names on
    // `slate:dom`, an `insertBefore(parent, node, before)` and a `removeChild(parent, node)`, are
    // the whole of what stands between that and a page that moves three nodes.
    patch(parent: integer, ops: array) =
        val list = held(parent)

        for op in ops
            val was = list.indexOf(op.node)

            if was != null then removeAt(list, was)

            if op.kind == "insert"
                val to = if op.before == null then null else list.indexOf(op.before)

                if to == null then push(list, op.node) else insert(list, to, op.node)

        setChildren(parent, list)

        null

    setNodeText(node: integer, s: string) =
        if nodeText(node) != s then setText(node, s)

        null

    // **What the page would show**, which is the same question the string host answers by building
    // the text itself. Asking it of the document is what lets a test compare the two.
    serialise(nodes: array) -> string =
        var out = ""

        for node in nodes
            out = out + markup(node)

        out

    // A node the framework has dropped. Giving the handle back is what stops the table growing as
    // long as everything the interface has ever rendered.
    drop(node: integer) =
        val key = string(node)

        // **`null` and not `undefined`**: slate refuses `undefined` in an object, which is the same
        // rule that refuses it in an array and for the same reason -- a hole that travels. `??`
        // above reads either as "nothing was here".
        attrs[key] = null
        hands[key] = null
        kids[key] = null

        release(node)

        null

    // **`mounted` is what puts the tree in the page, and it runs on every commit.** The framework
    // has no idea where a host's nodes are supposed to go -- which is exactly why the same framework
    // renders to a string -- so this is the one function that knows about `el`.
    mounted(nodes: array) =
        // **A copy, because the framework keeps that array too.** The cache below is written to in
        // place by `insertKid`, and sharing it would edit the reconciler's own record of the tree.
        kids[string(el)] = nodes.slice(0)

        setChildren(el, nodes)

        null

    // The child that is already there, for a render that adopts the page rather than building it.
    //
    // **`parent` of `null` is this host's own container**, which is the one place the framework has
    // no node to name -- the nodes at the very top of the tree have no host node above them.
    //
    // **It answers a RECORD and not a bare node.** `lath.slx` may not import `slate:dom`, so it
    // cannot ask a node its tag or its text; the host is the only thing that knows what a node is,
    // and handing back `{ node, tag, text }` is what keeps it that way. `tag` is `null` for a text
    // node, which is how the framework tells the two apart.
    // **The list is read ONCE per parent and kept**, which is two things at once. `children` mints a
    // fresh handle for every child it answers, so calling it per index would hand out one handle per
    // child per child -- a page's whole markup squared -- and the framework would hold a different
    // number for a node it had already adopted. Keeping the first answer makes the handles stable,
    // and it leaves this host knowing what every parent holds before a single render has happened,
    // which is exactly what `insert` and `remove` need after a hydrating render.
    adopt(parent, index: integer) =
        val into = parent ?? el
        val list = held(into)

        if list.len() == 0
            for kid in children(into)
                push(list, kid)

        if index >= list.len() then return null

        val node = list[index]

        { node: node, tag: tagName(node), text: nodeText(node) }

    { element: element, text: text, setProps: setProps, setText: setNodeText,
      serialise: serialise, drop: drop, mounted: mounted, adopt: adopt,
      patch: patch, into: el, where: into }

// A handler by its React spelling, attached under the DOM's: `onClick` is `click`, and dropping the
// `on` and lowering the letter after it is the whole of the translation.
//
// **The previous one is detached first**, and that is not tidiness. A component's handler is a fresh
// closure on every render, so a host that only ever added would leave one listener per render on the
// node and a single click would run every version of the handler the component had ever had.
listen(hands: object, node: integer, name: string, f) =
    val key = string(node) + " " + name
    val kind = name[2..].lower()
    val had = hands[key] ?? null

    if had == f then return null

    if had != null then off(node, kind, had)

    if f == null
        hands[key] = null

        return null

    on(node, kind, f)

    hands[key] = f

    null

isHandler(name: string) -> boolean =
    name.len() > 2 && name[0..<2] == "on" && name[2] == name[2].upper()

// -- the address bar ------------------------------------------------------------------------------

// The path the page is at, as state, so that a component re-renders when the page moves.
//
//     val here = usePath()
//
//     mount(router(routes, here), domHost("#app"))
//
// **THIS IS WHERE `lath/router` MEETS THE BROWSER, AND IT IS THE ONLY PLACE.** The router itself is
// handed a path and never reads one, which is what lets a server import it; everything that knows
// about an address bar is here, in the file that already owns the one import working in one host out
// of three.
//
// It does three things, and they are three halves of one arrangement: it holds the current path, it
// tells `Link` to push rather than follow, and it listens for the back button.
export usePath() -> string =
    val here = location()
    val [path, setPath] = useState(here.path + here.query + here.hash)

    // **`pushPath` does NOT raise `onNavigate`** -- a browser raises `popstate` for a movement the
    // user made and never for one the program made itself -- so a push has to set the state too, and
    // the listener below is only ever the back and forward buttons.
    go(to)
        pushPath(to)
        setPath(to)

    moved(where)
        setPath(where)

    // **Installed once and not on every render**, which is what the empty dependency list says. A
    // second `navigateWith` would be harmless and a second `onNavigate` would not: `slate:dom` keeps
    // one handler per registration, so a page re-rendering fifty times would hold fifty of them.
    wire()
        navigateWith(go)
        onNavigate(moved)

        null

    useEffect(wire, [])

    path

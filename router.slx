// lath/router -- one URL, one view, and an anchor that stays an anchor.
//
// **A route is a path template and a function, and there is nothing else to learn.** `"/notes/:id"`
// matches `/notes/42` and binds `id`; a plain `"/about"` matches itself; `"*"` matches anything and
// is the last case. There are no regular expression routes, because a template is what people write
// and a regular expression is what they debug.
//
//     val routes = [
//         { path: "/",          view: (m) -> <Home/> },
//         { path: "/notes/:id", view: (m) -> <Note id={m.params.id}/> },
//         { path: "*",          view: (m) -> <Missing at={m.path}/> },
//     ]
//
//     mount(router(routes, req.path))
//
// **THIS MODULE IMPORTS NOTHING THAT NEEDS A BROWSER**, which is the whole reason it is a module of
// its own rather than part of `lath.slx` or of `dom.slx`. A server rendering markup imports it and a
// page imports the same file; what differs between them is the path handed in, and nothing else.
//
// **`slate:url` is the reason that is true of the percent-coder as well.** Those four names were
// `slate:http`'s until slate 0.0.28 and importing that module into a page cost 239 KB -- a file
// server and an HTTP/2 speaker, to read a query string. They moved into a module of their own that
// asks nothing of the host, which is what this one needs.
//
// **A TEMPLATE ENDING IN `/*` MATCHES A PREFIX AND LEAVES THE REST FOR A ROUTER BELOW IT.** That is
// the whole of nesting: `"/notes/:id/*"` matches `/notes/7/edit`, binds `id`, and leaves `/edit` for
// a `router(routes)` called with no path at all, which reads the remainder -- and the parameters
// bound above it -- out of the context the outer router put the view inside.
//
//     val note = [
//         { path: "/",     view: (m) -> <Body id={m.params.id}/> },
//         { path: "/edit", view: (m) -> <Editor id={m.params.id}/> },
//         { path: "*",     view: (m) -> <Missing at={m.path}/> },
//     ]
//
//     Note(props) = <article>{router(note)}</article>
//
// **A NESTED ROUTER TAKES NO PATH, AND HAS TO BE INSIDE A COMPONENT.** No path, because `at` is the
// whole URL and the one thing that must not be handed in twice is where the page is; inside a
// component, because the context is found by walking up from whatever is rendering, and a view's
// body runs while its PARENT renders -- before the element it returns is anywhere. So
// `view: (m) -> <Note/>` with the nested router in `Note` is the arrangement, and
// `view: (m) -> router(note)` reads the context one level too high.
//
// **A relative `Link` resolves against the route it was written inside**, which is what lets a
// section be moved: `<Link to="edit">` under `/notes/:id` writes `/notes/7/edit`, and the same
// component mounted under `/drafts/:id` writes the other address without being told.

import { createElement, Element, useState, createContext, useContext } from "./lath.slx"
import { percentDecode, encodeComponent, parseQuery } from slate:url

// A route: the template a path is matched against, and what to render when it does.
//
// **`view` is a function of ONE record**, not of positional parameters, so a route view and an
// ordinary component read alike -- and so that a query, and whatever this grows next, arrive without
// changing what anybody already wrote.
export type Route = { path: string, view: function }

// What a view is handed.
//
// `params` are the `:name` segments -- every level's, an outer router's merged into an inner one's --
// `query` is what followed the `?`, and `path` is the cleaned path the match was made against: the
// WHOLE path at every depth, no fragment, no query, no trailing slash.
//
// **`base` is what the templates down to and including this one CONSUMED, and `tail` is what is
// LEFT** -- `null` where the template matched exactly and there is nothing below to route. A
// relative `Link` is resolved against `base`, and a nested `router()` matches against `tail`.
export type Match = { params: object, query: object, path: string, base: string, tail: string }

// -- reading a URL -------------------------------------------------------------------------------

// The path on its own, in the shape everything below compares against.
//
// **The fragment goes first and is never looked at again.** `location().hash` is the browser's
// business and a server is never sent one, so a router that matched on it would answer differently
// in the two places it is supposed to answer the same.
//
// **A trailing slash is not a different route**, `/` itself excepted, because a person typing a URL
// and a program building one disagree about it constantly and neither is wrong.
export cleanPath(url: string) -> string =
    var s = bareOf(url)

    if s == "" then s = "/"
    if s.length > 1 && endsWith(s, "/") then s = s[0..<s.length - 1]

    s

// The path as it STANDS, with the query and the fragment cut off and nothing else done to it.
//
// **This is not `cleanPath` and the difference is the point.** `cleanPath` normalises, because two
// spellings of one route have to match the same template; a URL being rewritten has to keep the
// spelling it had, or setting a query would quietly move a page from `/notes/` to `/notes` because
// somebody typed in a search box.
bareOf(url: string) -> string =
    var s = url
    val h = indexOf(s, "#")

    if h != null then s = s[0..<h]

    val q = indexOf(s, "?")

    if q != null then s = s[0..<q]

    s

// The `#...` with its `#`, or empty where there is none -- so that rewriting a query keeps it.
fragmentOf(url: string) -> string =
    val h = indexOf(url, "#")

    if h == null then "" else url[h..]

// What followed the `?`, with the fragment already off. Empty where there was none.
export searchOf(url: string) -> string =
    var s = url
    val h = indexOf(s, "#")

    if h != null then s = s[0..<h]

    val q = indexOf(s, "?")

    // **`indexOf` answers `null` and not `-1`**, which is slate's rule everywhere and is the one
    // thing a reader arriving from another language writes wrongly here.
    if q == null then "" else s[q + 1..]

// `a=1&b=two+words` as a record of strings.
//
// **`slate:url`'s `parseQuery` under a name that says what it is here**, and its rules come with it:
// a repeated name is the LAST one, and a name with no `=` is present and empty. The alternative
// every framework reaches for is an array where a name repeats, which makes the TYPE of `q.name`
// depend on what somebody put in a link.
export parseSearch(s: string) -> object = parseQuery(s)

// A record as the text that follows a `?`, which is `parseSearch` read backwards.
//
// **A field whose value is `null` is LEFT OUT**, which is how a name is taken out of a query: `set(q
// with { term: null })` and `set(without(q, "term"))` write the same address, and neither of them
// writes the four letters. `false` and `0` are values somebody chose and are written.
//
// **Every name and every value is percent-encoded**, `encodeComponent` leaving the unreserved set
// alone and encoding the rest -- so a query holding an `&`, a `=` or a space survives being read
// back by `parseSearch`.
export encodeSearch(q: object) -> string =
    var out = ""

    for [name, value] in entries(q)
        if value == null then continue

        if out != "" then out = out + "&"

        out = out + encodeComponent(name) + "=" + encodeComponent(string(value))

    out

// A URL with its query rewritten and everything else about it kept: the path as it was spelled, and
// the fragment.
export withSearch(url: string, q: object) -> string =
    val search = encodeSearch(q)

    bareOf(url) + (if search == "" then "" else "?" + search) + fragmentOf(url)

// -- matching ------------------------------------------------------------------------------------

// The `"*"` template, which matches every path there is.
export val Anything = "*"

// A path template matched against a cleaned path: the bound `:name` segments, or `null`.
//
// **Answering `null` rather than an empty record is what lets a route with no parameters be told
// from one that did not match at all**, `{}` being perfectly ordinary for `"/about"`.
//
// **A `:name` binds one segment and never a slash**, so `/notes/:id` does not match `/notes/1/edit`.
// A template that wants the rest of a path ends in `"*"`, which is what `"/notes/:id/*"` and the
// bare last case `"*"` both are.
export matchPath(template: string, path: string) -> object | null =
    val m = matchRoute(template, path)

    if m == null then return null

    m.params

// The same match with what it CONSUMED and what it LEFT: `{ params, base, tail }`, or `null`.
//
// **`base` and `tail` are cut out of the path AS IT WAS SPELLED**, segment by segment and still
// percent-encoded, because both of them are addresses again -- `base` is what a relative `Link` is
// resolved against and `tail` is what a router below matches. A decoded segment put back into either
// would be a different address the first time somebody's title had a slash in it.
matchRoute(template: string, path: string) -> object | null =
    val want = segmentsOf(template)
    val got = segmentsOf(path)

    // **A template whose last segment is `*` matches a PREFIX and keeps the rest**, which is the
    // whole of nesting. `"*"` on its own is that with a prefix of nothing, so a last case and a
    // nesting point are one rule rather than two.
    val open = want.length > 0 && want[want.length - 1] == Anything
    val need = if open then want.length - 1 else want.length

    if open
        if got.length < need then return null
    elif got.length != need
        return null

    var params = {}
    var i = 0

    while i < need
        val w = want[i]

        if startsWith(w, ":")
            // **The segment is decoded and the NAME is not.** A name is what the program wrote in
            // its own source; a segment is what arrived.
            params[w[1..]] = percentDecode(got[i], false)
        elif percentDecode(w, false) != percentDecode(got[i], false)
            return null

        i = i + 1

    val rest = joined(got, need, got.length)

    // **Nothing left is `/` and not the empty string**, so that a nested table's `"/"` route is what
    // a bare `/notes/7` under `"/notes/:id/*"` renders -- which is the index page of a section, and
    // the case a person writes first.
    { params: params, base: joined(got, 0, need),
      tail: if !open then null elif rest == "" then "/" else rest }

// A run of a path's segments back as a path -- `/a/b`, or empty where the run is.
joined(segs: array, from: integer, to: integer) -> string =
    var out = ""
    var i = from

    while i < to
        out = out + "/" + segs[i]
        i = i + 1

    out

// A path cut into its segments, with the empties dropped, so that `/` is no segments and `/a/` and
// `/a` are both one.
segmentsOf(path: string) -> array =
    var out = []

    for part in split(path, "/")
        if part != "" then push(out, part)

    out

// -- the route a view is standing in ---------------------------------------------------------------

// What a router tells the tree it rendered: the match itself, for the routers and the links below it.
//
// **It is a CONTEXT and not module state, and that is the difference nesting is made of.** `address`
// and `navigate` further down are one per program because a page has one address bar; a route is one
// per PLACE IN THE TREE, and two sections under two routers have to read two different answers at
// the same moment.
val RouteContext = createContext(null)

// The route the calling component is standing in -- `{ params, query, path, base, tail }` -- or
// `null` where nothing above it routed.
//
// **It is `useContext` underneath and so keeps no hook slot**, which is what lets a control read the
// parameters of whatever route it happens to be under, at any depth, without its author arranging
// for them to be handed down -- and lets it be called outside a render, where it answers `null`.
export useRoute() = useContext(RouteContext)

// Two records as one, the second winning.
//
// **The inner route's parameters win because they are the nearer**, which is the only answer that
// lets a section be written without knowing what the routes above it happened to call things.
merged(outer: object, inner: object) -> object =
    var out = {}

    for [name, value] in entries(outer)
        out[name] = value

    for [name, value] in entries(inner)
        out[name] = value

    out

// -- the router ----------------------------------------------------------------------------------

// The first route whose template matches, rendered.
//
// **`at` is handed in and never read from the world**, which is the whole of what makes one router
// answer for a server and a page: `req.path` on one side, the browser's own path on the other, and
// this file knowing about neither.
//
// **NO `at` MEANS A NESTED ROUTER**, which matches the `tail` its enclosing route left and inherits
// that route's parameters, query and base. It is the same function either way and a section's table
// reads exactly like a page's -- which is what lets a table written in another module be plugged in
// under a route without either end knowing where the other one is mounted.
//
// **Nothing matching is a FAULT and not an empty render**, unless a `"*"` route says what to do. A
// router that quietly rendered nothing would send the reader to look at the view, and the mistake is
// a missing route. A nested table needs its own `"*"`: the outer router has committed to its route
// by the time the tail is matched, so an unmatched tail is that SECTION's last case and not the
// page's.
export router(routes: array, at = null) -> Element =
    val outer = useRoute()

    var url = "/"
    var base = ""
    var inherited = {}
    var query = {}
    var whole = "/"

    if at != null
        // **Where the page is, remembered for `useSearch`.** A server hands this function the
        // request's URL and a browser hands it the address bar's, and neither of them tells anything
        // else -- so a component below that asks for the query would have nowhere to read it. This
        // is that nowhere, and it is why a router and a query hook live in one file.
        //
        // **A nested router never reaches this**, and must not: the address is the whole URL, and a
        // router handed a tail as though it were one would move the page to the tail.
        addressIs(at)

        url = at
        whole = cleanPath(at)
        query = parseSearch(searchOf(at))
    elif outer == null
        addressIs(url)
    else
        if outer.tail == null
            throw "a nested router has nothing to match under " + (if outer.base == "" then "/" else outer.base) + ", whose template matched the path exactly -- a route that routes below it ends its template in \"/*\""

        url = outer.tail
        base = outer.base
        inherited = outer.params
        query = outer.query
        whole = outer.path

    val path = cleanPath(url)

    for route in routes
        val m = matchRoute(route.path, path)

        if m != null
            val here = { params: merged(inherited, m.params), query: query, path: whole,
                         base: base + m.base, tail: m.tail }

            // **The view is rendered INSIDE a provider**, which is what a router below it and a
            // relative link below it both read. The value is a record and slate compares records
            // structurally, so a render that matched the same route with the same parameters is not
            // a change and costs nothing that stands under a `memo`.
            return createElement(RouteContext.Provider, { value: here }, [route.view(here)])

    var said = "no route matches " + path

    if base != "" then said = said + " under " + base

    throw said + ", and there is no \"" + Anything + "\" route to fall back on"

// -- links ---------------------------------------------------------------------------------------

// The attribute that says an anchor is this router's to intercept.
//
// **A marker rather than a handler on every anchor**, so a page rendered on a server and a page
// rendered in a browser are one program: the markup is the same either way, the link works with no
// slate on the page at all, and a middle click is a middle click because it is a real anchor.
export val LinkMark = "data-lath-link"

// What a `Link` calls instead of letting the browser follow it, or `null` where nothing installed
// one -- which is every server, and a page that has not asked.
//
// **The page hands this in and this module never reaches for it**, which is the whole of what keeps
// `lath/router` importable by a server: moving the address bar is `pushPath`, `pushPath` is the
// `dom` package's, and that package wants a page. `lath/dom`'s `usePath` installs it for a page that
// wants the ordinary arrangement.
//
// **It is module state, so there is one of it per program.** A page with two independent routers
// wants two, which is a thing to build when somebody has one; a router is a page's address bar and
// most pages have one address bar.
var navigate = null

// What `lath/dom`'s `usePath` installs for a page that never said what following a link means.
//
// **IT IS A SECOND SLOT AND NOT THE SAME ONE, WHICH IS THE WHOLE OF WHAT KEEPS A PROGRAM'S OWN
// ANSWER.** `useSearch` reads the address bar through `usePath`, so every component that asks for
// the query -- a sort control, a tag list, a pager -- installs the built-in navigator as a side
// effect of asking. Into one slot, the last of them to render wins: an application that had said
// `navigateWith(go)` at the top of its tree has that `go` quietly replaced by a hook belonging to
// some control three levels down, and a link then moves the address bar and re-renders *that
// control* rather than the page. Two slots and a rule about which wins is what makes both true --
// a page that asked gets what it asked for, and a page that did not still has working links.
var builtIn = null

// Tell every `Link` what to do instead of following.
//
// **The function is called `f(to, opts)`**, where `opts` of `{ push: false }` asks for the address
// to be REWRITTEN rather than pushed. Nothing said is a push, which is what a link is and what every
// caller written before there were two ways of moving meant.
//
// **What a program says here OUTRANKS the built-in one for as long as the program runs**, whichever
// was installed last: an application that holds the address itself -- because following a link means
// fetching a record, not only moving the view -- must not be overridden by a hook that only knows
// how to move the view.
export navigateWith(f) =
    navigate = f

    null

// The same, for the arrangement `lath/dom` installs on its own. Nothing else should call it.
export navigatesWith(f) =
    builtIn = f

    null

// Whichever of the two a movement goes through, or `null` where neither is installed -- which is
// every server, and a page that has imported neither a document nor a navigator of its own.
mover() = navigate ?? builtIn

// Whether a program installed a navigator of its own.
//
// **`lath/dom` asks this before it takes the back button, and `onNavigate` is why.** `onNavigate`
// keeps ONE handler for the whole program and the last registration wins -- so a hook listening for
// a movement would silently take the listener from a page that had installed one, and the page would
// stop hearing the back button altogether. A page that says what a movement means owns that handler.
export ownsNavigation() -> boolean = navigate != null

// Whether a click is one the router may take, or one the browser must have.
//
// **The modifiers and the button are the whole of it, and without them a router swallows the most
// ordinary thing anybody does to a link**: cmd-click opens a tab, shift-click a window, middle-click
// a tab, and every one of those is the browser's to do and not a framework's. `mods` and `button`
// were added to the event record for exactly this.
plainClick(e: object) -> boolean =
    e.button == 0 && !e.mods.meta && !e.mods.ctrl && !e.mods.shift && !e.mods.alt

// Whether a destination is one this page can render, which is a path of its own and not a URL
// somewhere else. `//elsewhere.example` is another origin written the short way.
ourOwn(to: string) -> boolean =
    to.length > 0 && to[0..<1] == "/" && !startsWith(to, "//")

// Whether a destination names a scheme -- `mailto:`, `https:` -- which is what says it is not a path.
//
// **A `:` only counts before the first `/`, `?` or `#`**, or `notes/a:b` would be somewhere else.
hasScheme(to: string) -> boolean =
    var i = 0

    while i < to.length
        val c = to[i..<i + 1]

        if c == ":" then return i > 0
        if c == "/" || c == "?" || c == "#" then return false

        i = i + 1

    false

// A `to` made absolute against the route it was written inside.
//
// **A `to` THAT DOES NOT START WITH A `/` IS RELATIVE TO THE ROUTE**, not to the page: `<Link
// to="edit">` inside `/notes/:id` is `/notes/7/edit`, and the same component mounted under
// `/drafts/:id` writes the other address without being told. That is what makes a section movable,
// and it is the reason the base is carried down at all. `..` walks up a segment and `.` stands
// still, the way they do everywhere else.
//
// **Anything with a scheme, and anything starting with a `/`, is left exactly as it was written**,
// so `mailto:` and `//elsewhere.example` do not quietly become paths on this site.
resolveTo(base: string, to: string) -> string =
    val self = if base == "" then "/" else base

    if to == "" then return self
    if startsWith(to, "/") || hasScheme(to) then return to
    if startsWith(to, "?") || startsWith(to, "#") then return self + to

    val bare = bareOf(to)
    var segs = segmentsOf(base)

    for part in split(bare, "/")
        if part == "" || part == "."
            continue
        elif part == ".."
            if segs.length > 0 then segs = segs[0..<segs.length - 1]
        else
            push(segs, part)

    val walked = joined(segs, 0, segs.length)

    (if walked == "" then "/" else walked) + to[bare.length..]

// An anchor that a router intercepts.
//
//     <Link to="/notes/42">the note</Link>
//
// **It renders a plain `<a href>`, and that is what makes a page one program.** The markup is the
// same on a server and in a browser, the link works with no slate on the page at all, and a middle
// click is a middle click because what was rendered is an ordinary anchor. What is added on top is a
// handler, which `stringHost` leaves out of markup anyway.
export Link(props: object) -> Element =
    // **Where this link is standing, so that a relative `to` can be resolved against it.** `useRoute`
    // keeps no hook slot and answers `null` outside a render, so a `Link` under no router at all --
    // on a page with one hand-written anchor, or in a test that calls it directly -- reads a base of
    // nothing and writes the `to` it was given.
    val here = useRoute()
    val to = resolveTo(if here == null then "" else here.base, props.to)

    followed(e)
        val move = mover()

        if move == null || !plainClick(e) || !ourOwn(to) then return null

        e.prevent()

        // **A link PUSHES**, a place somebody went being exactly what the back button is for.
        move(to, { push: true })

    var out = {}

    for name in keys(props)
        if name != "to" && name != "children" then out[name] = props[name]

    out["href"] = to
    out[LinkMark] = true
    out["onClick"] = followed

    createElement("a", out, props.children ?? [])

// -- the address, and the query as state ----------------------------------------------------------

// Where the page is, as this module knows it.
//
// **One address, set from two directions, which is what makes a server and a browser agree.**
// `router()` sets it from the URL it was handed -- a request's on a server, the address bar's on a
// page -- and `lath/dom`'s `usePath` sets it from the browser on every render and every movement.
// Neither end of this file knows which of the two it is looking at, and that is the whole point.
//
// **It is module state, so there is one of it per program**, which is `navigate` above read again: a
// page has one address bar, and a program that wants two independent ones wants something else.
var address = "/"

// Tell this module where the page is. `lath/dom` calls it, `router()` calls it, and a program moving
// the address itself calls it; nothing else has to.
export addressIs(url: string) =
    address = url

    null

// Where this module thinks the page is.
export addressNow() -> string = address

// The hook a page installs so that `useSearch` re-renders when the address moves.
//
// **It is `usePath`, and `lath/dom` installs it when that file is IMPORTED** -- not when a component
// renders. So whether it is there is decided by which modules the program is made of, before a
// single render, and it never changes while the program runs. That is what makes calling it inside
// `useSearch` a stable hook slot rather than a hook inside a condition.
var addressHook = null

// Tell this module how to read the address bar and be told when it moves.
export addressWith(f) =
    addressHook = f

    null

// The URL's query as state: what it says now, and how to rewrite it.
//
//     val [q, setQuery] = useSearch()
//
//     <input value={q.term ?? ""} onInput={(e) -> setQuery(q with { term: e.value })}/>
//     <button onClick={() -> setQuery(q with { page: 2 }, { push: true })}>next</button>
//
// **It is `useState`'s shape over the address bar rather than over a cell**, which is the whole
// argument for it: a filter, a sort order, a page number or an open tab put here is a thing somebody
// can bookmark, send to somebody else, and press back out of -- and one put in `useState` is a thing
// that vanishes on reload and cannot be linked to.
//
// **`set` REWRITES the address and does not push, unless it is asked to.** `set(q, { push: true })`
// pushes. The default is the one a search box needs: a push per keystroke would leave one history
// entry per letter and getting off the page would take twenty presses of back. A page number is the
// other case, and it asks.
//
// **A value of `null` takes the name out of the query**, which is `encodeSearch`'s rule.
//
// **On a server the query is the one `router()` was handed**, so a page rendered on a server and the
// same page hydrated in a browser read the same record and the markup matches. That is why this
// lives beside the router and not in `lath/dom`: `lath/dom` imports the `dom` package, whose every
// command wants a page, and a server rendering markup must not load it.
export useSearch() -> array =
    // **The slot is kept whether or not a page installed an address hook**, so that the two
    // arrangements have the same hook layout and the second `useState` in a component lands in the
    // same place either way. On a page it holds nothing and `usePath` is the state; where nothing
    // reads an address bar -- a server, a test on the string host -- it IS the state, which is what
    // makes `set` re-render there too.
    val [kept, setKept] = useState(null)
    val url = if addressHook != null then addressHook() else kept ?? address

    // The address rewritten, which is the setter half of the pair.
    //
    // **It is built against the URL THIS RENDER saw**, not against whatever the address bar says
    // when it is called, which is `useState`'s own rule: what a handler closed over is what the
    // component was showing.
    set(next, opts = null) =
        if !(next is object)
            throw "a query is a record of names and values, and this is " + string(next)

        val to = withSearch(url, next)
        val pushes = opts != null && opts.push == true
        val move = mover()

        if move == null
            addressIs(to)
            setKept(to)
        else
            move(to, { push: pushes })

        null

    [parseSearch(searchOf(url)), set]

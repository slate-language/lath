// lath -- elements, function components, hooks and a keyed reconciler, written in slate.
//
// The name is the strip a roof's slates are nailed to: the frame the pieces hang on.
//
// **React's model and React's mechanism, not a substitute for either.** A component is a function of
// its props; state lives in hooks kept on call-order slots; a change re-renders the component that
// owns it and the reconciler matches the new children against the old by key. That is what the
// framework was asked for, and every departure from it below is marked and argued.
//
// **The host is behind an adapter, which is what lets the same components render twice.** Nothing
// here knows what a node is: `stringHost` builds objects and serialises them, and the DOM host in `dom.slx`
// creates real elements through the same nine functions. So a page renders to HTML on a server and to
// the document in a browser from one source -- which is the thing that makes this worth writing in
// slate rather than reaching for React.

import { patchKids } from "./reconcile.slx"
import { hostElement, hostText, hostSetProps, hostSetText, serialiseNodes, hostDrop, hostMounted,
    hostAdopt, hostPatch } from "./markup.slx"

// -- elements --------------------------------------------------------------------------------

// What `<>...</>` is an element of. A string no tag can be, so it never collides with a host name.
export val Fragment = "#fragment"

// What an element IS, so that a component can say what it answers.
//
// **`type` is deliberately `any`**: a host element's is the tag as text, a component's is the
// function itself, and a fragment's is `Fragment`. **`key` is `any` and not `string`** because it is
// whatever a program wrote and is `null` where nothing did — what a key needs is to compare equal to
// itself, which every slate value does.
export type Element = { type: any, props: object, key: any }

// The ten functions a host answers, and nothing above them knows what a node is.
//
// **A program writing its own host annotates it with this** — `myHost() -> Host` — which is the one
// check there is that an adapter is whole. It shipped with six of these: an adapter with one
// implementation is a guess, and not one of the four that arrived later was guessable from the
// first implementation.
//
// **`patch(parent, ops)` REPLACED A `setKids` THAT TOOK THE WHOLE LIST**, and the count is the same
// because it is the same slot filled differently. Replacing a parent's children is one call and the
// right answer while the only host is a string; on a page it rebuilds a thousand rows to move three,
// and takes the focus, the selection and the scroll position with them. `ops` is what CHANGED, in
// order — `{ kind: "remove", node }` and `{ kind: "insert", node, before }`, where `before` of
// `null` means the end and where inserting a node the parent already holds MOVES it, which is what
// `insertBefore` does.
//
// **A host is handed the whole batch and not one operation at a time**, which is the difference
// between the two kinds of host: one that can move a single child walks the list, and one that can
// only write a whole child list applies the operations to a list of its own and writes once.
//
// **`styles(sheets)` is handed the WHOLE list of distinct stylesheets whenever it grows**, in the
// order they were registered, and never one sheet at a time. That is `mounted`'s shape and it is
// chosen for `mounted`'s reason: a host told what the set now IS can decide for itself what it has
// already done about it.
//
// **It is called on a HYDRATING commit too, and the host is expected to compare before it writes** —
// which is the rule `setProps` and `setText` already follow and is what makes a hydrated page make no
// mutations. A page's sheets came with the server's markup; the host can see them, so it writes
// none. A server that forgot one is the case that separates this from a flag saying *do nothing*:
// the host puts that one in, which is a mutation and is the right answer.
export type Host = { element: function, text: function, setProps: function, setText: function, serialise: function, drop: function, mounted: function, adopt: function, patch: function, styles: function }

// What every element in the source is desugared into.
//
// **The children go into `props.children`**, which is React's arrangement and is what lets a
// component pass on what it was given without knowing it is doing so.
export createElement(type, props: object, kids: array) -> Element =
    { type: type, props: props with { children: kids }, key: props.key ?? null }

// -- the render in progress ------------------------------------------------------------------

// The instance being rendered, and which of its hooks the component is up to.
//
// **A hook is found by the ORDER it was called in**, which is React's implementation and needs
// nothing slate lacks -- a counter reset at the top of each render and an array on the instance.
// The cost is React's too: a hook may not be called inside a condition, because the slot it lands in
// would move.
var rendering = null
var slot = 0

// -- hooks -------------------------------------------------------------------------------------

// A value the component keeps between renders, and the function that changes it.
//
// The pair is an array so that it comes apart the way it is written in React:
//
//     val [count, setCount] = useState(0)
//
// **The setter takes a value or a function of the old one**, and does nothing at all where the new
// value equals the old -- so a component that sets its state to what it already holds does not
// re-render, which is what stops an effect from looping.
export useState(initial) -> array =
    val cell = hookCell({ value: initial })
    val inst = rendering

    [cell.value, next ->
        val v = if next is function then next(cell.value) else next

        if v != cell.value
            cell.value = v
            invalidate(inst)]

// State changed by an action rather than by a value, which is `useState` with the reducer in front.
export useReducer(reduce: function, initial) -> array =
    val [state, set] = useState(initial)

    [state, action -> set(s -> reduce(s, action))]

// A box the component keeps, whose `current` may be written without re-rendering anything.
export useRef(initial) -> object = hookCell({ current: initial })

// A value worked out only when what it depends on changes.
//
// **The dependencies are compared with slate's `==`, which is STRUCTURAL, where React compares each
// one by identity.** `[1, 2] == [1, 2]` is true in slate and false in JavaScript, so an object
// rebuilt with the same fields does not count as a change here and does in React. That is a
// deliberate divergence: it is the host language's own answer, it is the one a slate reader will
// predict, and the surprising direction -- recomputing when nothing changed -- is the one it removes.
export useMemo(make: function, deps) =
    val cell = hookCell({ value: null, deps: null, first: true })

    if cell.first || cell.deps != deps
        cell.value = make()
        cell.deps = deps
        cell.first = false

    cell.value

// A function kept between renders, which is `useMemo` of the function itself.
export useCallback(f: function, deps) = useMemo(() -> f, deps)

// Work to do after the render has been committed, and how to undo it.
//
// **The cleanup runs before the next effect and again when the component goes**, which is what makes
// an effect that subscribes to something safe to write. Leaving `deps` out runs it after every
// render, which is React's rule read the same way.
export useEffect(run: function, deps = null) =
    val cell = hookCell({ deps: null, cleanup: null, first: true })

    if cell.first || deps == null || cell.deps != deps
        cell.deps = deps
        cell.first = false

        push(rendering.root.effects, { cell: cell, run: run })

// -- stylesheets ---------------------------------------------------------------------------------

// The css a component needs, registered once for the whole page.
//
//     import styles from "./card.css"
//
//     Card(props) =
//         style(styles)
//
//         <div class="card">{props.children}</div>
//
// **The argument is ORDINARY CSS AS TEXT, and an asset import is where it comes from**: slate reads
// the file while the program is compiled and hands it over as a string, so the stylesheet is a file
// an editor highlights and a browser's dev tools understand rather than a string literal in a
// component. Six components importing one sheet is one string, on both back ends.
//
// **It is registered once per DISTINCT SHEET and not once per component or once per render.** The
// list is deduplicated by the string itself, which is what makes calling this at the top of every
// render the right thing to write: a component that renders fifty times, and fifty components that
// import the same file, are one `<style>`.
//
// **The two hosts put it in the two places a sheet can go.** `html(root)` writes one `<style>` per
// sheet — at the end of the `<head>` where the tree has one, and in front of the markup where it is
// a fragment. A page injects one `<style>` per sheet into the document's head, once.
//
// **A hydrating page injects NOTHING**, the server having already written every sheet the first
// render registers: a hydrated page makes no mutations at all, and a stylesheet written a second
// time would be one — and a duplicated rule, which is worse than a wasted write because it changes
// what the cascade does.
//
// **It is not a hook.** It keeps no slot, so it may be called inside a condition where `useState`
// may not — which is the point, a component that only sometimes renders the thing the sheet is about
// being the ordinary case.
//
// **There is no way to take a sheet back, deliberately.** A sheet is registered by a component that
// USES it and is deduplicated across every component that does, so nothing knows when the last user
// has gone; removing one on unmount would strip the rules out from under whoever else had asked for
// them. A page's stylesheets grow to the set of components it has rendered and stop there.
export style(css) =
    // The error path first, because a sheet that is not text is a mistake in the import and the
    // fault has to name the argument rather than something further down about a string.
    if !(css is string)
        throw "style is given a stylesheet as text, and this is " + string(css)

    if rendering == null
        throw "style is called while a component renders, and nothing is rendering"

    // **`</style` is refused rather than escaped**, which is the whole of what makes writing the css
    // raw safe: a `<style>` element's content is raw text and that is the one string that can end it
    // early. Escaping instead would break a `&` in a `content:` string and a `<` in a selector.
    // **`indexOf` and not `contains`**, this file having a `contains` of its own that takes an array.
    if indexOf(css.lower(), "</style") != null
        throw "a stylesheet may not contain \"</style\", which would end the element it is written in"

    val root = rendering.root

    if root.sheets.indexOf(css) == null then push(root.sheets, css)

    null

// The sheets registered so far, handed to the host whenever that list grows.
//
// **The hydrating commit hands them over like any other, and the host is what makes that free.** The
// markup the page is standing on carries a `<style>` for every sheet the first render registers, so
// a host that compares before it writes writes nothing — which is the same rule that keeps an
// attribute already right from being written again. Writing one twice would be a mutation, and a
// duplicated rule, which is worse than a wasted write because it changes what the cascade does.
styled(root: object) =
    if root.sheets == root.styled then return null

    root.styled = root.sheets.slice(0)

    root.host.styles(root.styled)

    null

// The slot this hook call owns, made on the first render and found again on every one after.
hookCell(fresh: object) -> object =
    val inst = rendering
    val i = slot

    slot = slot + 1

    if i >= inst.hooks.len() then push(inst.hooks, fresh)

    inst.hooks[i]

// -- instances -------------------------------------------------------------------------------

// **An instance is what an element BECAME, and it is what survives a re-render.** The element is a
// description made fresh every time; the instance holds the hooks, the host node and the children it
// was matched against, which is the whole reason a component's state does not go when its props
// change.
// **`nodes` is what the host was last told this instance's children are**, and it is the other half
// of the diff: a parent that does not remember what it put there can only replace the lot.
instance(root: object, parent, el, kind: string) -> object =
    { root: root, parent: parent, el: el, kind: kind, key: null, hooks: [], kids: [], left: [],
      nodes: [], node: null, gone: false, epoch: -1, caught: null }

// What a child amounts to: nothing, a string, or an element.
//
// **`null`, `undefined` and the two booleans render nothing**, which is what makes `{cond && <a/>}`
// the ordinary way to write a conditional child.
flatten(kids: array, out: array) -> array =
    for kid in kids
        if kid == null || kid == undefined || kid == true || kid == false
            continue

        if kid is array
            flatten(kid, out)
        else
            push(out, kid)

    out

kindOf(el) -> string =
    if el is string || el is number then "text"
    elif el.type == Portal then "portal"
    elif el.type == Fragment then "fragment"
    elif el.type is function then "component"
    else "host"

// Whether an old instance may be updated by this element rather than replaced.
//
// **The key is asked first and the type second**, which is the whole of what a key is for: two
// elements of the same type in the same position are the same thing unless their keys say otherwise.
matches(old, el) -> boolean =
    if old == null then return false
    if old.kind != kindOf(el) then return false

    if old.kind == "text" then return true
    if old.key != (el.key ?? null) then return false

    // **A portal that is given a different container is a different portal.** Its children would
    // otherwise be updated in place and left in the container they were put in first.
    if old.kind == "portal" then return old.el.props.into == el.props.into

    old.el.type == el.type

// -- reconciling -----------------------------------------------------------------------------

// One child, matched against what stood there before.
reconcile(root: object, parent, old, el) -> object =
    if !matches(old, el)
        if old != null then unmount(old)

        return build(root, parent, el)

    // **The one place a subtree is not rendered at all.** `old.el` is deliberately left alone: the
    // props a skipped component compares against next time are the ones it last actually rendered.
    if old.kind == "component" && skips(old, el) then return old

    old.el = el

    update(old)

    old

build(root: object, parent, el) -> object =
    val kind = kindOf(el)
    val inst = instance(root, parent, el, kind)

    if kind == "text"
        inst.node = if root.claim == null then root.host.text(string(el)) else claimText(root, string(el))

        return inst

    inst.key = el.key ?? null

    if kind == "host"
        inst.node = if root.claim == null then root.host.element(el.type) else claimElement(root, el.type)

    update(inst)

    inst

// -- hydration -------------------------------------------------------------------------------

// What the page already has where this one goes, or a fault saying what was found instead.
//
// **The cursor is a position among the HOST children of the nearest host ancestor**, which is not the
// same as a position in the element tree: a component and a fragment have no node of their own, so
// their children sit among their parent's. `root.claim` is that cursor and it is pushed and restored
// around every host element's children.
//
// **`adopt` answers a RECORD and not a bare node**, and that is what keeps the adapter an adapter:
// `lath.slx` may not import `slate:dom`, so it cannot ask a node its tag or its text -- the host is
// the only thing that knows what a node is. `{ node, tag, text }`, with `tag` null for a text node.
claimed(root: object, want: string) =
    val cursor = root.claim
    val found = root.host.adopt(cursor.into, cursor.at)

    push(root.trail, cursor.at)

    cursor.at = cursor.at + 1

    if found == null then mismatch(root, want, "nothing -- the markup ran out")

    found

claimText(root: object, want: string) =
    val found = claimed(root, "the text " + toJSON(want))

    if found.tag != null then mismatch(root, "the text " + toJSON(want), "<" + found.tag + ">")
    if found.text != want
        mismatch(root, "the text " + toJSON(want), "the text " + toJSON(found.text))

    pop(root.trail)

    found.node

// **This one does NOT pop the trail and the text one does**, which is the whole of how a path reads
// `page > 0 > 1`: an element's own index has to stay on the trail while its children are walked, and
// `update` takes it off when it is done with them. A text node has no children and is finished here.
claimElement(root: object, tag: string) =
    val found = claimed(root, "<" + tag + ">")

    if found.tag != tag
        mismatch(root, "<" + tag + ">",
            if found.tag == null then "the text " + toJSON(found.text) else "<" + found.tag + ">")

    found.node

// **A MISMATCH IS A FAULT AND THERE IS NO FALLING BACK TO A CLIENT RENDER.** A page that quietly
// rebuilt what it could not adopt would hide a server and a client that disagree -- which is the one
// defect hydration exists to expose -- and it would hide it behind a page that looks right.
mismatch(root: object, wanted: string, found: string) =
    // **The brackets are what continue the line**, a trailing `+` outside a bracket pair not being a
    // continuation in slate.
    throw ("the page does not match what was rendered: at " + where(root) +
        " the tree wants " + wanted + " and the page has " + found)

// The path to the node being adopted: the host's own name for where it mounts, then the child index
// at each level down. `#app > 0 > 2` is the third child of the first child of the container.
where(root: object) -> string =
    var out = root.host.where ?? "the root"

    for i in root.trail
        out = out + " > " + string(i)

    out

update(inst: object) =
    if inst.kind == "text"
        inst.root.host.setText(inst.node, string(inst.el))

        return null

    if inst.kind == "component"
        renderComponent(inst)

        return null

    if inst.kind == "portal"
        renderPortal(inst)

        return null

    if inst.kind == "host"
        inst.root.host.setProps(inst.node, inst.el.props)

    val root = inst.root
    val outer = root.claim

    // **A host element's children are counted from ITS node and from zero**, so the cursor is pushed
    // here and put back afterwards. A component or a fragment pushes nothing: its children stand
    // among its parent's, which is exactly what having no node of its own means.
    if outer != null && inst.kind == "host" then root.claim = { into: inst.node, at: 0 }

    reconcileKids(inst, inst.el.props.children)

    if outer != null && inst.kind == "host"
        // **The page may not have MORE children than the tree wanted**, which is the other half of
        // running out: a server that rendered an extra row would otherwise leave it on the page for
        // ever, adopted by nothing and updated by nothing.
        val spare = root.host.adopt(inst.node, root.claim.at)

        if spare != null
            push(root.trail, root.claim.at)
            mismatch(root, "nothing more",
                if spare.tag == null then "the text " + toJSON(spare.text) else "<" + spare.tag + ">")

        root.claim = outer

        // This element's own index, put on by `claimElement` and kept while its children were walked.
        pop(root.trail)

    if inst.kind == "host" then holdKids(inst, outer == null)

    null

// A component rendered, and its answer matched against what it rendered before.
renderComponent(inst: object) =
    rendering = inst
    slot = 0

    var out = null

    // **A render that faults has to put this back, and a boundary is not enough on its own.**
    // `recoverAt` clears it for a subtree that had one above it; where nothing catches, the fault
    // leaves the program with `rendering` still naming a dead instance -- and the next `style` or
    // `useContext` called from outside a render reads that instance instead of saying there is no
    // render. It is the sort of leak a suite only sees when one test faults before another asks.
    try
        out = inst.el.type(inst.el.props)
    catch e
        rendering = null

        throw e

    rendering = null

    inst.epoch = contextEpoch

    if inst.el.type != Boundary
        reconcileKids(inst, [out])

        return null

    // Once a boundary has caught something it renders the fallback and not its children, which is
    // what stops a subtree that faults on every render from faulting on every render.
    if inst.caught != null
        reconcileKids(inst, [inst.el.props.fallback(inst.caught)])

        return null

    try
        reconcileKids(inst, [out])
    catch e
        recoverAt(inst, e)

    null

// A portal's children, rendered into the container the portal names.
//
// **A portal contributes no nodes to the parent that wrote it**, which is what lets a dialog written
// inside a table row escape the row: its children stand in another parent entirely.
renderPortal(inst: object) =
    val root = inst.root
    val outer = root.claim

    // **Hydration does not adopt a portal's content.** What a server sent has the portal's children
    // wherever the portal put them and not where the element was written, so the cursor walking this
    // parent's children must not step over them -- the content is built rather than claimed.
    root.claim = null

    reconcileKids(inst, inst.el.props.children)

    root.claim = outer

    val next = childNodes(inst)

    patchKids(root.host, inst.el.props.into, inst.nodes, next)

    inst.nodes = next

    null

// The children a host node holds now, told to the host as the smallest run of moves that gets there.
//
// **During hydration nothing is told at all**, which is what `write` is false for: every child was
// adopted from this very node at consecutive positions and the count was just checked, so the list
// is already right -- and touching it would be a mutation, the one thing a hydrated page must not
// make. The list is remembered either way, because the render after this one diffs against it.
holdKids(inst: object, write: boolean) =
    val next = childNodes(inst)

    if write then patchKids(inst.root.host, inst.node, inst.nodes, next)

    inst.nodes = next

    null

// The nearest boundary above `inst`, handed what went wrong.
//
// **The failed subtree is unmounted rather than left half-built**, and the boundary renders its
// fallback with the fault object in its hands. Nothing is swallowed: the value reaches the fallback,
// which is an ordinary component and may show it, log it or send it somewhere.
recoverAt(inst, e) -> boolean =
    var at = inst

    while at != null
        if at.kind == "component" && at.el.type == Boundary
            // The render that faulted left this set, there being no statement of its own left to run.
            rendering = null

            for kid in at.kids
                unmount(kid)

            // **And the ones the render that faulted had not reached yet**, which are the children
            // that were STANDING when it began: an effect they subscribed with is still installed,
            // and nothing else is ever going to take it down.
            for kid in at.left
                unmount(kid)

            at.kids = []
            at.left = []
            at.caught = e

            reconcileKids(at, [at.el.props.fallback(e)])

            return true

        at = at.parent

    false

// The children, matched against the ones that stood there before.
//
// **A key is looked for among the old children before position is**, so a row inserted at the top of
// a list moves the rows below it rather than rewriting every one of them.
reconcileKids(inst: object, kids: array) =
    val wanted = flatten(kids, [])
    val old = inst.kids
    var used = []
    var next = []

    // **The new list goes onto the instance BEFORE it is filled, and the old one is kept beside it.**
    // A child that faults part of the way through leaves this loop unfinished, and an error boundary
    // then has to take down what was built -- which it can only do if it can reach it. Without these
    // two lines a failed render leaks every node it had made before it failed.
    inst.kids = next
    inst.left = old

    for i in 0..<wanted.len()
        val el = wanted[i]
        val found = takeMatch(old, used, el, i)

        push(next, reconcile(inst.root, inst, found, el))

    // Whatever was not matched is gone, and its effects have to be undone.
    for i in 0..<old.len()
        if !contains(used, i) then unmount(old[i])

    inst.left = []

    null

// The old child this element should update, by key where it has one and by position otherwise.
takeMatch(old: array, used: array, el, i: integer) =
    val key = if el is string || el is number then null else el.key ?? null

    if key != null
        for j in 0..<old.len()
            if !contains(used, j) && old[j].key == key
                push(used, j)

                return old[j]

        return null

    if i < old.len() && !contains(used, i) && old[i].key == null
        push(used, i)

        return old[i]

    null

contains(xs: array, v) -> boolean =
    for x in xs
        if x == v then return true

    false

// The host nodes an instance stands for, innermost first.
//
// **A component and a fragment have no node of their own**, so they answer with their children's --
// which is what lets a component return several things without a tag around them.
nodesOf(inst: object) -> array =
    if inst.kind == "text" || inst.kind == "host" then return [inst.node]

    // **A portal answers NONE**, its children standing in a container of its own.
    if inst.kind == "portal" then return []

    childNodes(inst)

// The nodes an instance's CHILDREN stand for.
//
// **Not `nodesOf` of the instance itself, which for a host node is that node.** Setting a host node's
// children to its own node makes the tree hold itself, and what comes back is a recursion 10,000
// deep in the serialiser rather than anything that names the mistake.
childNodes(inst: object) -> array =
    var out = []

    for kid in inst.kids
        for node in nodesOf(kid)
            push(out, node)

    out

// A subtree that is no longer rendered: every effect it left behind is undone, deepest first.
unmount(inst: object) =
    // **Twice is once**, which is what lets the two lists below be walked without asking whether an
    // instance is in both -- and asking would mean comparing two instances, which slate would do
    // structurally through the root, the parent and every node under them.
    if inst.gone then return null

    inst.gone = true

    // A portal's children stand in a container of their own, and this is what takes them out of it.
    if inst.kind == "portal" then patchKids(inst.root.host, inst.el.props.into, inst.nodes, [])

    for kid in inst.kids
        unmount(kid)

    // The children a render that faulted had not decided about yet. Empty every other time.
    for kid in inst.left
        unmount(kid)

    for cell in inst.hooks
        if cell.cleanup is function
            cell.cleanup()
            cell.cleanup = null

    // **The host is told the node has gone, and it is told at the COMMIT rather than here.** For the
    // string host it is nothing; for a DOM host it is what gives back the table slot the node stood
    // in, and without it a long-running interface grows a table as long as everything it has ever
    // rendered. It waits for the commit because a node is taken out of its parent BY HANDLE -- a
    // host handed the handle back first would have nothing left to take out.
    if inst.node != null then push(inst.root.dropped, inst.node)

    null

// -- roots -----------------------------------------------------------------------------------

// An element rendered, and kept so that it can be rendered again.
export mount(el, host = null) -> object =
    val root = newRoot(host ?? stringHost())

    root.inst = reconcile(root, null, null, el)

    commit(root)

    root

// An element ADOPTED: the same render, taking the nodes already on the page instead of creating them.
//
//     hydrate(<App/>, domHost("#app"))
//
// **A hydrated page makes no DOM mutations at all**, which is the whole point and is what the jsdom
// check measures with a `MutationObserver`. Everything that would have been created is adopted;
// everything that would have been set is compared first and set only where it differs; and the child
// lists are not set at all, each child having been adopted from its parent in order.
//
// **Handlers are attached, and that is what hydration is FOR.** The markup a server sent is already
// the page; what it does not have is a single event listener, and the tree this walks is what
// installs them.
//
// **Markup that does not match is a fault** naming the path and both sides. There is no falling back
// to building the tree: a page that quietly rebuilt what it could not adopt would hide a server and
// a client that disagree, which is the defect hydration exists to expose.
export hydrate(el, host = null) -> object =
    val root = newRoot(host ?? stringHost())

    root.claim = { into: null, at: 0 }
    root.trail = []

    root.inst = reconcile(root, null, null, el)

    // **The tree may not have left anything over at the top either.** `null` is the host's own
    // container, so this is the same count check every host element gets, asked of the root.
    val spare = root.host.adopt(null, root.claim.at)

    if spare != null
        push(root.trail, root.claim.at)
        mismatch(root, "nothing more",
            if spare.tag == null then "the text " + toJSON(spare.text) else "<" + spare.tag + ">")

    // **The commit happens while the claim is still set**, which is what keeps `mounted` from being
    // called: those nodes are already the container's children and handing them to the host again is
    // a mutation. Every commit after this one is ordinary.
    commit(root)

    root.claim = null

    root

newRoot(host) -> object =
    { host: host, inst: null, pending: [], effects: [], scheduled: false, claim: null, trail: [],
      nodes: [], dropped: [], sheets: [], styled: [] }

// The rendered tree as text, which is what the string host is for.
export html(root: object) -> string = root.host.serialise(nodesOf(root.inst))


// Every state change since the last one, rendered.
//
// **A change does not render on the spot.** Two `setState` calls in one handler are one render, which
// is React's batching and is what stops a handler from being able to see a half-updated tree.
export flush(root: object) =
    loop
        if root.pending.len() == 0 then break

        val waiting = root.pending

        root.pending = []

        for inst in waiting
            if !inst.gone then rendered(inst)

        // A component that re-rendered may have changed what its parent's host node holds.
        refreshNodes(root.inst)

    commit(root)

    null

// A component whose state changed, rendered -- and the nearest boundary told where it faulted.
//
// **The `try` is here and not around the whole flush**, so that one component failing does not take
// the rest of the queue with it.
rendered(inst: object) =
    try
        update(inst)
    catch e
        // A boundary catches its own children and never itself, so the search starts above.
        if !recoverAt(inst.parent, e) then throw e

    null

// What the render leaves the host to do: the top of the tree, the nodes that went, and the effects.
commit(root: object) =
    // **Before the early return below, because a hydrating commit still has to REMEMBER its
    // sheets** — it is the commit after it that would otherwise write every one of them again.
    styled(root)

    // **A hydrating commit does not hand the host the top of the tree**, because those nodes are
    // already the container's children and putting them there again is a mutation -- which is the one
    // thing a hydrated page must not make. It is remembered, so the commit after this one has
    // something to compare against.
    if root.claim != null
        root.nodes = nodesOf(root.inst)

        released(root)
        runEffects(root)

        return null

    val nodes = nodesOf(root.inst)

    // **The host is handed the top of the tree whenever that set CHANGES, and not only the first
    // time.** A host node's children are patched by the reconciler, but the nodes at the very TOP
    // have no host node above them -- so when a component at the root renders a different set,
    // nothing else would have told the host. The string host cannot see the difference, `html`
    // walking the tree afresh each time; a DOM host would leave an element on the page that the
    // program had stopped rendering.
    //
    // **Comparing first is what keeps a re-render from touching the container**: handing a host the
    // same list again is a whole child list replaced with itself, which an observer sees, styles
    // recompute for, and a scroll position is lost to.
    if root.nodes != nodes
        root.nodes = nodes

        root.host.mounted(nodes)

    released(root)
    runEffects(root)

// The nodes the render tore down, given back to the host now that they have left the page.
released(root: object) =
    val gone = root.dropped

    root.dropped = []

    for node in gone
        root.host.drop(node)

    null

// The effects the render queued, run outermost first, each after its own cleanup.
runEffects(root: object) =
    val queued = root.effects

    root.effects = []

    for e in queued
        if e.cell.cleanup is function then e.cell.cleanup()

        e.cell.cleanup = e.run()

    null

// A component re-rendered underneath a host node, so that node's children have changed.
//
// **A walk of the whole tree that asks the host for nothing where nothing moved**, which is what the
// diff bought: every host node compares the children it holds against the ones it held, and a node
// whose subtree did not change is two array reads and no host call at all.
refreshNodes(inst: object) =
    for kid in inst.kids
        refreshNodes(kid)

    if inst.kind == "host" then holdKids(inst, true)

    if inst.kind == "portal"
        val next = childNodes(inst)

        patchKids(inst.root.host, inst.el.props.into, inst.nodes, next)

        inst.nodes = next

    null

// A component whose state changed, wanting to be rendered again.
invalidate(inst: object) =
    if inst.gone then return null

    val root = inst.root

    for waiting in root.pending
        if waiting == inst then return null

    push(root.pending, inst)

    if !root.scheduled
        root.scheduled = true

        // **A one-line lambda, because a block one has to be the LAST argument** -- a block runs to
        // the end of its last line, and the `, 0)` here would arrive first.
        setTimeout(() -> scheduled(root), 0)

    null

scheduled(root: object) =
    root.scheduled = false

    flush(root)

// -- context ---------------------------------------------------------------------------------

// **What a provider changing counts as**, and it is one number rather than a subscription list. See
// `skips` for the whole of what it buys.
var contextEpoch = 0

// A value handed to a whole subtree without being passed through every component in between.
//
//     val Theme = createContext("light")
//
//     App(props) = <Theme.Provider value="dark"><Page/></Theme.Provider>
//
//     Page(props) = <p class={useContext(Theme)}>dark or light</p>
//
// **The provider is a FIELD of the context rather than a second name to import**, which is React's
// arrangement and works here for a reason worth knowing: a dot inside a tag is an ordinary field
// selection, so `<Theme.Provider>` needs nothing from slate that `<Menu.Item>` does not.
//
// **A context is compared by identity and not by name**, so two contexts with the same default are
// two contexts, and a program may make one per module without arranging anything.
export createContext(fallback = null) -> object =
    val ctx = { fallback: fallback, Provider: null }

    provider(props: object) =
        val last = useRef({ set: false, value: null })

        // **A change is noticed HERE, at the provider, and not by the consumers.** What it does is
        // move a counter that every memoised component is compared against, which is what makes a
        // provider's change reach a consumer standing under a `memo`.
        if !last.current.set || last.current.value != props.value
            last.current = { set: true, value: props.value }

            contextEpoch = contextEpoch + 1

        props.children

    ctx.Provider = provider

    ctx

// The nearest provider's value, or the context's own default where nothing above provided one.
//
// **A missing provider is the DEFAULT and not a fault**, which is React's rule and the useful one: a
// component that reads a theme can be rendered on its own in a test, and a context whose absence
// really is a mistake says so by making its default a value that complains.
//
// **It is not a hook**, keeping no slot of its own -- so unlike `useState` it may be called inside a
// condition. The name follows React's because everything else about it does.
export useContext(ctx: object) =
    var at = rendering

    while at != null
        if at.kind == "component" && at.el.type == ctx.Provider then return at.el.props.value

        at = at.parent

    ctx.fallback

// -- memo ------------------------------------------------------------------------------------

// The components `memo` has wrapped, and how each of them compares its props.
//
// **A table rather than a mark on the function**, slate having nowhere to hang a field on a function
// value. A function compares by identity, so walking this finds the right entry and nothing else.
var memos = []

// A component that is not rendered again while its props are what they were.
//
//     val Row = memo(row)
//     val Row = memo(row, (was, now) -> was.id == now.id)
//
// **The comparison is slate's `==`, which is STRUCTURAL**, where React's default is field-by-field
// identity. That is this package's standing divergence read once more: props rebuilt with the same
// fields are the same props. A handler written as a fresh lambda every render is still a change, a
// function comparing by identity -- which is what `useCallback` is for, there as here.
//
// **A provider that changed value renders through every memo below it**, which is a deliberate
// pessimism: tracking which subtree reads which context is a great deal of machinery to avoid a
// render on the one turn a provider actually changed.
export memo(component: function, areEqual = null) -> function =
    if areEqual != null && !(areEqual is function)
        throw "memo's second argument is how two props compare, and this is " + string(areEqual)

    memoised(props: object) = component(props)

    push(memos, { fn: memoised, same: areEqual })

    memoised

memoOf(f) =
    for m in memos
        if m.fn == f then return m

    null

// Whether an update may be skipped altogether, which is the one place the framework does not render.
skips(old: object, el) -> boolean =
    val m = memoOf(el.type)

    if m == null then return false
    if old.epoch != contextEpoch then return false

    val answer = if m.same == null then old.el.props == el.props else m.same(old.el.props, el.props)

    // **A comparator that answers something else is a fault naming the comparator**, not a silent
    // truthiness test: `0` is true in slate and false in JavaScript, so a comparator ported from
    // React would otherwise skip every render and be extremely hard to see.
    if !(answer is boolean)
        // **The brackets are what continue the line**, a trailing `+` outside a bracket pair not
        // being a continuation in slate.
        throw ("memo's comparator answers whether two props are the same, and this answered " +
            string(answer))

    answer

// -- error boundaries --------------------------------------------------------------------------

// A component that renders something else when its subtree faults.
//
//     <Boundary fallback={(e) -> <p class="broken">{e.message}</p>}>
//         <Page/>
//     </Boundary>
//
// **A RENDER FAULT STAYS A FAULT, and this CATCHES one rather than turning it into a result.** slate's
// two channels decide that and not React: a result is for a condition the caller was always going to
// deal with, and a component that cannot render is a defect in the program. So no component is handed
// an `{ ok: false }` to look at -- the fault unwinds to the nearest boundary exactly as it would
// unwind to a `try`, which is what this is.
//
// **Nothing is swallowed.** The subtree that failed is unmounted and `fallback` is called with the
// fault object -- `message`, `line` and `file` -- so a boundary that shows nothing is one somebody
// wrote to show nothing.
//
// **It does not catch its own render**, which is React's rule for React's reason: the fallback is
// this component's answer, and a component whose own body faults has nothing left to answer with.
// Put a boundary above it.
export Boundary(props: object) -> array = props.children

// -- portals ---------------------------------------------------------------------------------

// What a portal is an element of. A string no tag can be, so it never collides with a host name.
export val Portal = "#portal"

// A subtree rendered into a container somewhere else.
//
//     createPortal(<Dialog/>, byId("modals"))
//
// **The container is the HOST's kind of node and not an element.** On a page it is what `byId` or
// `query` answers; on a string host it is what `stringHost().element("div")` answers. A portal's
// children are that node's children, and the parent that wrote the portal is handed none of them --
// which is what lets a dialog written inside a table row escape the row.
//
// **On a string host it renders into the node it was given and `html(root)` does not show it**,
// unless that node is itself somewhere in the tree being serialised. That is the honest answer
// rather than a fault: a portal is content put *somewhere else*, and where a server puts it is the
// server's business -- `serialise` of the container is how a server asks what went there.
export createPortal(el, into) -> Element =
    { type: Portal, props: { into: into, children: [el] }, key: null }

// -- the string host -------------------------------------------------------------------------

// **Ten functions, and nothing above them knows what a node is.** A DOM host answers the same ten
// over real elements, which is what makes the components on both sides one set of components. It
// shipped with six, needed `drop` and `mounted` to render into a document and `adopt` to hydrate
// one; `patch` is `setKids`'s slot, filled with what changed rather than with what the list now is,
// and `styles` is the stylesheets a render asked for.
//
// **It is built here and not at the top level of `markup.slx` because it REMEMBERS something now.**
// Eight of the ten are ordinary functions of their arguments and are still imported; the sheets are
// this host's own, so that two renders on one server are two answers and not one shared list.
export stringHost() -> Host =
    var sheets = []

    // The whole list, every time, so this is an assignment rather than a merge.
    styles(list: array) =
        sheets = list

        null

    // **The sheets are part of the markup**, which is the string host's whole answer to where a
    // stylesheet goes: a server's job is to send a page, and a page's `<style>` is in the page.
    serialise(nodes: array) -> string = serialiseNodes(nodes, sheets)

    { element: hostElement, text: hostText, setProps: hostSetProps,
      setText: hostSetText, serialise: serialise, drop: hostDrop, mounted: hostMounted,
      adopt: hostAdopt, patch: hostPatch, styles: styles }

// lath -- elements, function components, hooks and a keyed reconciler, written in slate.
//
// The name is the strip a roof's slates are nailed to: the frame the pieces hang on.
//
// **React's model and React's mechanism, not a substitute for either.** A component is a function of
// its props; state lives in hooks kept on call-order slots; a change re-renders the component that
// owns it and the reconciler matches the new children against the old by key. That is what the
// framework was asked for, and every departure from it below is marked and argued.
//
// **The host is behind an adapter, which is what lets the same components render twice.** Nothing
// here knows what a node is: `stringHost` builds objects and serialises them, and the DOM host in `dom.slx`
// creates real elements through the same eight functions. So a page renders to HTML on a server and to
// the document in a browser from one source -- which is the thing that makes this worth writing in
// slate rather than reaching for React.

// -- elements --------------------------------------------------------------------------------

// What `<>...</>` is an element of. A string no tag can be, so it never collides with a host name.
export val Fragment = "#fragment"

// What an element IS, so that a component can say what it answers.
//
// **`type` is deliberately `any`**: a host element's is the tag as text, a component's is the
// function itself, and a fragment's is `Fragment`. **`key` is `any` and not `string`** because it is
// whatever a program wrote and is `null` where nothing did — what a key needs is to compare equal to
// itself, which every slate value does.
export type Element = { type: any, props: object, key: any }

// The eight functions a host answers, and nothing above them knows what a node is.
//
// **A program writing its own host annotates it with this** — `myHost() -> Host` — which is the one
// check there is that an adapter is whole. It shipped with six of these and needed eight: an adapter
// with one implementation is a guess, and the two that were missing are `drop` and `mounted`.
export type Host = { element: function, text: function, setProps: function, setKids: function, setText: function, serialise: function, drop: function, mounted: function, adopt: function }

// What every element in the source is desugared into.
//
// **The children go into `props.children`**, which is React's arrangement and is what lets a
// component pass on what it was given without knowing it is doing so.
export createElement(type, props: object, kids: array) -> Element =
    { type: type, props: props with { children: kids }, key: props.key ?? null }

// -- the render in progress ------------------------------------------------------------------

// The instance being rendered, and which of its hooks the component is up to.
//
// **A hook is found by the ORDER it was called in**, which is React's implementation and needs
// nothing slate lacks -- a counter reset at the top of each render and an array on the instance.
// The cost is React's too: a hook may not be called inside a condition, because the slot it lands in
// would move.
var rendering = null
var slot = 0

// -- hooks -------------------------------------------------------------------------------------

// A value the component keeps between renders, and the function that changes it.
//
// The pair is an array so that it comes apart the way it is written in React:
//
//     val [count, setCount] = useState(0)
//
// **The setter takes a value or a function of the old one**, and does nothing at all where the new
// value equals the old -- so a component that sets its state to what it already holds does not
// re-render, which is what stops an effect from looping.
export useState(initial) -> array =
    val cell = hookCell({ value: initial })
    val inst = rendering

    [cell.value, next ->
        val v = if next is function then next(cell.value) else next

        if v != cell.value
            cell.value = v
            invalidate(inst)]

// State changed by an action rather than by a value, which is `useState` with the reducer in front.
export useReducer(reduce: function, initial) -> array =
    val [state, set] = useState(initial)

    [state, action -> set(s -> reduce(s, action))]

// A box the component keeps, whose `current` may be written without re-rendering anything.
export useRef(initial) -> object = hookCell({ current: initial })

// A value worked out only when what it depends on changes.
//
// **The dependencies are compared with slate's `==`, which is STRUCTURAL, where React compares each
// one by identity.** `[1, 2] == [1, 2]` is true in slate and false in JavaScript, so an object
// rebuilt with the same fields does not count as a change here and does in React. That is a
// deliberate divergence: it is the host language's own answer, it is the one a slate reader will
// predict, and the surprising direction -- recomputing when nothing changed -- is the one it removes.
export useMemo(make: function, deps) =
    val cell = hookCell({ value: null, deps: null, first: true })

    if cell.first || cell.deps != deps
        cell.value = make()
        cell.deps = deps
        cell.first = false

    cell.value

// A function kept between renders, which is `useMemo` of the function itself.
export useCallback(f: function, deps) = useMemo(() -> f, deps)

// Work to do after the render has been committed, and how to undo it.
//
// **The cleanup runs before the next effect and again when the component goes**, which is what makes
// an effect that subscribes to something safe to write. Leaving `deps` out runs it after every
// render, which is React's rule read the same way.
export useEffect(run: function, deps = null) =
    val cell = hookCell({ deps: null, cleanup: null, first: true })

    if cell.first || deps == null || cell.deps != deps
        cell.deps = deps
        cell.first = false

        push(rendering.root.effects, { cell: cell, run: run })

// The slot this hook call owns, made on the first render and found again on every one after.
hookCell(fresh: object) -> object =
    val inst = rendering
    val i = slot

    slot = slot + 1

    if i >= inst.hooks.len() then push(inst.hooks, fresh)

    inst.hooks[i]

// -- instances -------------------------------------------------------------------------------

// **An instance is what an element BECAME, and it is what survives a re-render.** The element is a
// description made fresh every time; the instance holds the hooks, the host node and the children it
// was matched against, which is the whole reason a component's state does not go when its props
// change.
instance(root: object, parent, el, kind: string) -> object =
    { root: root, parent: parent, el: el, kind: kind, key: null, hooks: [], kids: [], node: null, gone: false }

// What a child amounts to: nothing, a string, or an element.
//
// **`null`, `undefined` and the two booleans render nothing**, which is what makes `{cond && <a/>}`
// the ordinary way to write a conditional child.
flatten(kids: array, out: array) -> array =
    for kid in kids
        if kid == null || kid == undefined || kid == true || kid == false
            continue

        if kid is array
            flatten(kid, out)
        else
            push(out, kid)

    out

kindOf(el) -> string =
    if el is string || el is number then "text"
    elif el.type == Fragment then "fragment"
    elif el.type is function then "component"
    else "host"

// Whether an old instance may be updated by this element rather than replaced.
//
// **The key is asked first and the type second**, which is the whole of what a key is for: two
// elements of the same type in the same position are the same thing unless their keys say otherwise.
matches(old, el) -> boolean =
    if old == null then return false
    if old.kind != kindOf(el) then return false

    if old.kind == "text" then return true
    if old.key != (el.key ?? null) then return false

    old.el.type == el.type

// -- reconciling -----------------------------------------------------------------------------

// One child, matched against what stood there before.
reconcile(root: object, parent, old, el) -> object =
    if !matches(old, el)
        if old != null then unmount(old)

        return build(root, parent, el)

    old.el = el

    update(old)

    old

build(root: object, parent, el) -> object =
    val kind = kindOf(el)
    val inst = instance(root, parent, el, kind)

    if kind == "text"
        inst.node = if root.claim == null then root.host.text(string(el)) else claimText(root, string(el))

        return inst

    inst.key = el.key ?? null

    if kind == "host"
        inst.node = if root.claim == null then root.host.element(el.type) else claimElement(root, el.type)

    update(inst)

    inst

// -- hydration -------------------------------------------------------------------------------

// What the page already has where this one goes, or a fault saying what was found instead.
//
// **The cursor is a position among the HOST children of the nearest host ancestor**, which is not the
// same as a position in the element tree: a component and a fragment have no node of their own, so
// their children sit among their parent's. `root.claim` is that cursor and it is pushed and restored
// around every host element's children.
//
// **`adopt` answers a RECORD and not a bare node**, and that is what keeps the adapter an adapter:
// `lath.slx` may not import `slate:dom`, so it cannot ask a node its tag or its text -- the host is
// the only thing that knows what a node is. `{ node, tag, text }`, with `tag` null for a text node.
claimed(root: object, want: string) =
    val cursor = root.claim
    val found = root.host.adopt(cursor.into, cursor.at)

    push(root.trail, cursor.at)

    cursor.at = cursor.at + 1

    if found == null then mismatch(root, want, "nothing -- the markup ran out")

    found

claimText(root: object, want: string) =
    val found = claimed(root, "the text " + toJSON(want))

    if found.tag != null then mismatch(root, "the text " + toJSON(want), "<" + found.tag + ">")
    if found.text != want
        mismatch(root, "the text " + toJSON(want), "the text " + toJSON(found.text))

    pop(root.trail)

    found.node

// **This one does NOT pop the trail and the text one does**, which is the whole of how a path reads
// `page > 0 > 1`: an element's own index has to stay on the trail while its children are walked, and
// `update` takes it off when it is done with them. A text node has no children and is finished here.
claimElement(root: object, tag: string) =
    val found = claimed(root, "<" + tag + ">")

    if found.tag != tag
        mismatch(root, "<" + tag + ">",
            if found.tag == null then "the text " + toJSON(found.text) else "<" + found.tag + ">")

    found.node

// **A MISMATCH IS A FAULT AND THERE IS NO FALLING BACK TO A CLIENT RENDER.** A page that quietly
// rebuilt what it could not adopt would hide a server and a client that disagree -- which is the one
// defect hydration exists to expose -- and it would hide it behind a page that looks right.
mismatch(root: object, wanted: string, found: string) =
    // **The brackets are what continue the line**, a trailing `+` outside a bracket pair not being a
    // continuation in slate.
    throw ("the page does not match what was rendered: at " + where(root) +
        " the tree wants " + wanted + " and the page has " + found)

// The path to the node being adopted: the host's own name for where it mounts, then the child index
// at each level down. `#app > 0 > 2` is the third child of the first child of the container.
where(root: object) -> string =
    var out = root.host.where ?? "the root"

    for i in root.trail
        out = out + " > " + string(i)

    out

update(inst: object) =
    if inst.kind == "text"
        inst.root.host.setText(inst.node, string(inst.el))

        return null

    if inst.kind == "component"
        rendering = inst
        slot = 0

        val out = inst.el.type(inst.el.props)

        rendering = null

        reconcileKids(inst, [out])

        return null

    if inst.kind == "host"
        inst.root.host.setProps(inst.node, inst.el.props)

    val root = inst.root
    val outer = root.claim

    // **A host element's children are counted from ITS node and from zero**, so the cursor is pushed
    // here and put back afterwards. A component or a fragment pushes nothing: its children stand
    // among its parent's, which is exactly what having no node of its own means.
    if outer != null && inst.kind == "host" then root.claim = { into: inst.node, at: 0 }

    reconcileKids(inst, inst.el.props.children)

    if outer != null && inst.kind == "host"
        // **The page may not have MORE children than the tree wanted**, which is the other half of
        // running out: a server that rendered an extra row would otherwise leave it on the page for
        // ever, adopted by nothing and updated by nothing.
        val spare = root.host.adopt(inst.node, root.claim.at)

        if spare != null
            push(root.trail, root.claim.at)
            mismatch(root, "nothing more",
                if spare.tag == null then "the text " + toJSON(spare.text) else "<" + spare.tag + ">")

        root.claim = outer

        // This element's own index, put on by `claimElement` and kept while its children were walked.
        pop(root.trail)

    // **Nothing is SET during hydration.** Every child was adopted from this node at consecutive
    // positions and the count was just checked, so the list is already what it should be -- and
    // setting it would be a mutation, which is the one thing a hydrated page must not make.
    if inst.kind == "host" && outer == null then inst.root.host.setKids(inst.node, childNodes(inst))

    null

// The children, matched against the ones that stood there before.
//
// **A key is looked for among the old children before position is**, so a row inserted at the top of
// a list moves the rows below it rather than rewriting every one of them.
reconcileKids(inst: object, kids: array) =
    val wanted = flatten(kids, [])
    val old = inst.kids
    var used = []
    var next = []

    for i in 0..<wanted.len()
        val el = wanted[i]
        val found = takeMatch(old, used, el, i)

        push(next, reconcile(inst.root, inst, found, el))

    // Whatever was not matched is gone, and its effects have to be undone.
    for i in 0..<old.len()
        if !contains(used, i) then unmount(old[i])

    inst.kids = next

    null

// The old child this element should update, by key where it has one and by position otherwise.
takeMatch(old: array, used: array, el, i: integer) =
    val key = if el is string || el is number then null else el.key ?? null

    if key != null
        for j in 0..<old.len()
            if !contains(used, j) && old[j].key == key
                push(used, j)

                return old[j]

        return null

    if i < old.len() && !contains(used, i) && old[i].key == null
        push(used, i)

        return old[i]

    null

contains(xs: array, v) -> boolean =
    for x in xs
        if x == v then return true

    false

// The host nodes an instance stands for, innermost first.
//
// **A component and a fragment have no node of their own**, so they answer with their children's --
// which is what lets a component return several things without a tag around them.
nodesOf(inst: object) -> array =
    if inst.kind == "text" || inst.kind == "host" then return [inst.node]

    childNodes(inst)

// The nodes an instance's CHILDREN stand for.
//
// **Not `nodesOf` of the instance itself, which for a host node is that node.** Setting a host node's
// children to its own node makes the tree hold itself, and what comes back is a recursion 10,000
// deep in the serialiser rather than anything that names the mistake.
childNodes(inst: object) -> array =
    var out = []

    for kid in inst.kids
        for node in nodesOf(kid)
            push(out, node)

    out

// A subtree that is no longer rendered: every effect it left behind is undone, deepest first.
unmount(inst: object) =
    inst.gone = true

    for kid in inst.kids
        unmount(kid)

    for cell in inst.hooks
        if cell.cleanup is function
            cell.cleanup()
            cell.cleanup = null

    // **The host is told the node has gone.** For the string host that is nothing; for a DOM host it
    // is what gives back the table slot the node was standing in, and without it a long-running
    // interface grows a table as long as everything it has ever rendered.
    if inst.node != null then inst.root.host.drop(inst.node)

    null

// -- roots -----------------------------------------------------------------------------------

// An element rendered, and kept so that it can be rendered again.
export mount(el, host = null) -> object =
    val root = newRoot(host ?? stringHost())

    root.inst = reconcile(root, null, null, el)

    commit(root)

    root

// An element ADOPTED: the same render, taking the nodes already on the page instead of creating them.
//
//     hydrate(<App/>, domHost("#app"))
//
// **A hydrated page makes no DOM mutations at all**, which is the whole point and is what the jsdom
// check measures with a `MutationObserver`. Everything that would have been created is adopted;
// everything that would have been set is compared first and set only where it differs; and the child
// lists are not set at all, each child having been adopted from its parent in order.
//
// **Handlers are attached, and that is what hydration is FOR.** The markup a server sent is already
// the page; what it does not have is a single event listener, and the tree this walks is what
// installs them.
//
// **Markup that does not match is a fault** naming the path and both sides. There is no falling back
// to building the tree: a page that quietly rebuilt what it could not adopt would hide a server and
// a client that disagree, which is the defect hydration exists to expose.
export hydrate(el, host = null) -> object =
    val root = newRoot(host ?? stringHost())

    root.claim = { into: null, at: 0 }
    root.trail = []

    root.inst = reconcile(root, null, null, el)

    // **The tree may not have left anything over at the top either.** `null` is the host's own
    // container, so this is the same count check every host element gets, asked of the root.
    val spare = root.host.adopt(null, root.claim.at)

    if spare != null
        push(root.trail, root.claim.at)
        mismatch(root, "nothing more",
            if spare.tag == null then "the text " + toJSON(spare.text) else "<" + spare.tag + ">")

    // **The commit happens while the claim is still set**, which is what keeps `mounted` from being
    // called: those nodes are already the container's children and handing them to the host again is
    // a mutation. Every commit after this one is ordinary.
    commit(root)

    root.claim = null

    root

newRoot(host) -> object =
    { host: host, inst: null, pending: [], effects: [], scheduled: false, claim: null, trail: [] }

// The rendered tree as text, which is what the string host is for.
export html(root: object) -> string = root.host.serialise(nodesOf(root.inst))


// Every state change since the last one, rendered.
//
// **A change does not render on the spot.** Two `setState` calls in one handler are one render, which
// is React's batching and is what stops a handler from being able to see a half-updated tree.
export flush(root: object) =
    loop
        if root.pending.len() == 0 then break

        val waiting = root.pending

        root.pending = []

        for inst in waiting
            if !inst.gone then update(inst)

        // A component that re-rendered may have changed what its parent's host node holds.
        refreshNodes(root.inst)

    commit(root)

    null

// The effects the render queued, run outermost first, each after its own cleanup.
commit(root: object) =
    // **A hydrating commit does not hand the host the top of the tree**, because those nodes are
    // already the container's children and putting them there again is a mutation -- which is the one
    // thing a hydrated page must not make. Every commit after this one does.
    if root.claim != null
        runEffects(root)

        return null

    // **The host is handed the top of the tree on every commit, not only the first.** A host node's
    // children are set by the reconciler, but the nodes at the very TOP have no host node above them
    // -- so when a component at the root renders a different set, nothing would have told the host.
    // The string host cannot see the difference, `html` walking the tree afresh each time; a DOM
    // host would leave an element on the page that the program had stopped rendering.
    root.host.mounted(nodesOf(root.inst))

    runEffects(root)

// The effects the render queued, run outermost first, each after its own cleanup.
runEffects(root: object) =
    val queued = root.effects

    root.effects = []

    for e in queued
        if e.cell.cleanup is function then e.cell.cleanup()

        e.cell.cleanup = e.run()

    null

// A component re-rendered underneath a host node, so that node's children have changed.
refreshNodes(inst: object) =
    for kid in inst.kids
        refreshNodes(kid)

    if inst.kind == "host" then inst.root.host.setKids(inst.node, childNodes(inst))

    null

// A component whose state changed, wanting to be rendered again.
invalidate(inst: object) =
    if inst.gone then return null

    val root = inst.root

    for waiting in root.pending
        if waiting == inst then return null

    push(root.pending, inst)

    if !root.scheduled
        root.scheduled = true

        // **A one-line lambda, because a block one has to be the LAST argument** -- a block runs to
        // the end of its last line, and the `, 0)` here would arrive first.
        setTimeout(() -> scheduled(root), 0)

    null

scheduled(root: object) =
    root.scheduled = false

    flush(root)

// -- the string host -------------------------------------------------------------------------

// **Eight functions, and nothing above them knows what a node is.** A DOM host answers the same eight
// over real elements, which is what makes the components on both sides one set of components. It
// shipped with six and needed `drop` and `mounted`; the count here said six for two releases after
// that, which is what a number written in prose does.
export stringHost() -> Host =
    { element: hostElement, text: hostText, setProps: hostSetProps, setKids: hostSetKids,
      setText: hostSetText, serialise: serialiseNodes, drop: hostDrop, mounted: hostMounted,
      adopt: hostAdopt }

// **A string host has nothing to hydrate, and this FAULTS rather than answering nothing.** A server
// is the thing that renders the markup a page hydrates; it never hydrates anything itself. Answering
// `null` here would make `hydrate` quietly fall back to building the tree, which is the failure
// hydration exists to expose wearing a disguise.
hostAdopt(parent, index: integer) =
    throw "a string host has nothing to hydrate -- markup is what it produces, not what it adopts"


hostElement(tag: string) -> object = { tag: tag, props: {}, kids: [] }

// A string host's node is an ordinary object and the collector takes it; there is nothing to give
// back. The function exists so that the adapter is one shape rather than two.
hostDrop(node) = null

// **Nothing, and that is the interesting one.** A string host has nowhere to put the tree -- the
// tree IS the answer, and `html` walks it afresh whenever it is asked. A DOM host has built real
// elements that are not in the page until something appends them, which is what this is for.
hostMounted(nodes: array) = null

hostText(s: string) -> object = { text: s }

hostSetProps(node: object, props: object) =
    node.props = props

hostSetKids(node: object, kids: array) =
    node.kids = kids

hostSetText(node: object, s: string) =
    node.text = s

serialiseNodes(nodes: array) -> string =
    var out = ""

    for node in nodes
        out = out + serialiseNode(node)

    out

serialiseNode(node: object) -> string =
    if node.tag == undefined then return escapeText(node.text)

    var out = "<" + node.tag + attributes(node.props) + ">"

    if isVoid(node.tag) then return out

    for kid in node.kids
        out = out + serialiseNode(kid)

    out + "</" + node.tag + ">"

// **`children`, `key` and every handler are left out of the markup**, the first two being the
// framework's own and a handler having nowhere to go in text. A `true` is a bare attribute and a
// `false`, `null` or `undefined` is no attribute at all, which is HTML's own rule.
attributes(props: object) -> string =
    var out = ""

    for [name, value] in entries(props)
        if name == "children" || name == "key" then continue
        if isHandler(name) then continue
        if value == false || value == null || value == undefined then continue

        if value == true
            out = out + " " + name
        else
            out = out + " " + name + "=\"" + escapeAttr(string(value)) + "\""

    out

isHandler(name: string) -> boolean =
    name.len() > 2 && name[0..<2] == "on" && name[2] == name[2].upper()

isVoid(tag: string) -> boolean =
    ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"].indexOf(tag) != null

// **Text is escaped, and that is not a nicety.** A renderer that puts what it was given straight into
// the markup hands whoever supplied the text control of the page.
escapeText(s: string) -> string = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

escapeAttr(s: string) -> string = escapeText(s).replace("\"", "&quot;")
